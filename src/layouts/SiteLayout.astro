---
import '../styles/global.css';
import type { SiteMeta } from '../lib/sites';
import SEO from '../components/SEO.astro';
import StructuredData, {
  type PageKind,
  type FaqItem,
  type BreadcrumbItem,
} from '../components/StructuredData.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';

interface Props {
  site: SiteMeta;
  title: string;
  description: string;
  urlPath: string;
  kind: PageKind;
  author: string;
  publishedTime?: string;
  modifiedTime?: string;
  faqs?: FaqItem[];
  breadcrumbs?: BreadcrumbItem[];
  ogImagePath?: string;
}

const {
  site,
  title,
  description,
  urlPath,
  kind,
  author,
  publishedTime,
  modifiedTime,
  faqs,
  breadcrumbs,
  ogImagePath,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <SEO
      title={title}
      description={description}
      urlPath={urlPath}
      site={site}
      ogType={kind === 'top' ? 'website' : 'article'}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      ogImagePath={ogImagePath}
    />

    <StructuredData
      site={site}
      kind={kind}
      pageTitle={title}
      pageDescription={description}
      urlPath={urlPath}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      faqs={faqs}
      breadcrumbs={breadcrumbs}
    />
  </head>
  <body class="min-h-screen bg-white text-slate-900 antialiased">
    <Header site={site} />
    <main class="mx-auto max-w-5xl px-4 py-8 sm:py-12">
      <slot />
    </main>
    <ContactForm site={site} />
    <Footer site={site} />
  </body>
</html>
