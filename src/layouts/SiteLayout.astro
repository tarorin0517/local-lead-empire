---
import '../styles/global.css';
import type { SiteMeta } from '../lib/sites';
import SEO from '../components/SEO.astro';
import StructuredData, {
  type PageKind,
  type FaqItem,
  type BreadcrumbItem,
} from '../components/StructuredData.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import StickyCTA from '../components/StickyCTA.astro';

interface Props {
  site: SiteMeta;
  title: string;
  description: string;
  urlPath: string;
  kind: PageKind;
  author: string;
  publishedTime?: string;
  modifiedTime?: string;
  faqs?: FaqItem[];
  breadcrumbs?: BreadcrumbItem[];
  ogImagePath?: string;
  /** トップページのように、本文側で ContactForm を埋め込み済みの場合は true */
  hideAutoContactForm?: boolean;
  /** フッターに表示する最終更新日 */
  lastUpdated?: Date;
  /** main の上下余白を抑制したい（フルブリードのトップページ向け） */
  fullBleed?: boolean;
}

const {
  site,
  title,
  description,
  urlPath,
  kind,
  author,
  publishedTime,
  modifiedTime,
  faqs,
  breadcrumbs,
  ogImagePath,
  hideAutoContactForm = false,
  lastUpdated,
  fullBleed = false,
} = Astro.props;

const mainClass = fullBleed
  ? 'min-h-screen'
  : 'mx-auto min-h-screen max-w-5xl px-4 py-8 sm:py-12';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <SEO
      title={title}
      description={description}
      urlPath={urlPath}
      site={site}
      ogType={kind === 'top' ? 'website' : 'article'}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      ogImagePath={ogImagePath}
    />

    <StructuredData
      site={site}
      kind={kind}
      pageTitle={title}
      pageDescription={description}
      urlPath={urlPath}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      faqs={faqs}
      breadcrumbs={breadcrumbs}
    />
  </head>
  <body class="has-sticky-cta min-h-screen bg-bg text-ink antialiased">
    <Header site={site} />
    <main class={mainClass}>
      <slot />
    </main>
    {!hideAutoContactForm && <ContactForm site={site} />}
    <Footer site={site} lastUpdated={lastUpdated} />
    <StickyCTA site={site} />
  </body>
</html>
