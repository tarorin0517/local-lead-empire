---
import type { SiteMeta } from '../lib/sites';
import { telHref } from '../lib/sites';

interface Props {
  site: SiteMeta;
}

const { site } = Astro.props;
---

<div
  class="fixed inset-x-0 bottom-0 z-50 flex border-t border-primary-100 bg-white shadow-[0_-4px_12px_rgba(0,0,0,0.08)] md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom)"
>
  <a
    href={telHref(site.phone)}
    class="flex flex-1 items-center justify-center gap-2 bg-accent-500 px-3 py-3 text-sm font-bold text-white"
    aria-label={`電話で相談する ${site.phone}`}
    onclick={`if(typeof gtag!=='undefined'){gtag('event','generate_lead',{method:'phone',event_label:'sticky_cta'});gtag('event','phone_click',{event_category:'cta',event_label:'sticky_cta',site_key:'${site.siteKey}'})}`}
  >
    <span aria-hidden="true">📞</span>
    電話で相談
  </a>
  {site.lineUrl && (
    <a
      href={site.lineUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-1 items-center justify-center gap-2 bg-[#06C755] px-3 py-3 text-sm font-bold text-white"
      onclick={`gtag && gtag('event','line_click',{event_category:'cta',event_label:'sticky_cta',site_key:'${site.siteKey}'})`}
    >
      <span aria-hidden="true">💬</span>
      LINE相談
    </a>
  )}
  <a
    href="#contact"
    class={`flex items-center justify-center gap-2 bg-primary-700 px-3 py-3 text-sm font-bold text-white ${site.lineUrl ? 'flex-1' : 'flex-1'}`}
    onclick={`gtag && gtag('event','form_click',{event_category:'cta',event_label:'sticky_cta',site_key:'${site.siteKey}'})`}
  >
    <span aria-hidden="true">✉️</span>
    無料見積もり
  </a>
</div>
