---
import type { SiteMeta } from '../lib/sites';

interface Props {
  site: SiteMeta;
}

const { site } = Astro.props;
const telHref = `tel:${site.phone.replace(/[^\d+]/g, '')}`;
const hasForm = Boolean(site.contactFormUrl);
---

<section id="contact" class="mt-16 scroll-mt-20">
  <div class="mx-auto max-w-3xl px-4">
    <h2 class="text-2xl font-bold text-brand-900 sm:text-3xl">
      お問い合わせ
    </h2>
    <p class="mt-2 text-sm text-slate-600">
      症状・希望日時・お住まいのエリアをお書き添えください。
      受付時間内であれば、最短当日中に折り返しご連絡します。
    </p>

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <a
        href={telHref}
        class="flex flex-col items-center rounded-lg border border-brand-200 bg-white p-5 text-center shadow-sm hover:border-brand-400"
      >
        <span class="text-xs text-slate-500">電話で相談</span>
        <span class="mt-1 text-xl font-bold text-brand-700">{site.phone}</span>
        <span class="mt-1 text-xs text-slate-500">{site.phoneHoursLabel ?? '受付時間内'}</span>
      </a>
      <a
        href="#contact-form"
        class="flex flex-col items-center justify-center rounded-lg bg-accent-500 p-5 text-center text-white shadow-sm hover:bg-accent-600"
      >
        <span class="text-xs">フォームから相談</span>
        <span class="mt-1 text-base font-bold">下のフォームへ</span>
      </a>
    </div>

    <div id="contact-form" class="mt-8 rounded-lg border border-slate-200 bg-white p-4">
      {hasForm ? (
        <iframe
          src={site.contactFormUrl}
          width="100%"
          height="720"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          loading="lazy"
          title="お問い合わせフォーム"
        >読み込み中...</iframe>
      ) : (
        <div class="rounded border border-dashed border-slate-300 bg-slate-50 p-6 text-sm text-slate-600">
          <p class="font-semibold text-slate-800">
            お問い合わせフォーム（Google Forms）埋め込み枠
          </p>
          <p class="mt-2">
            <code class="rounded bg-white px-1.5 py-0.5 text-xs">_meta.json</code> の
            <code class="rounded bg-white px-1.5 py-0.5 text-xs">contactFormUrl</code>
            に Google Forms の埋め込み URL（
            <code class="rounded bg-white px-1.5 py-0.5 text-xs">.../viewform?embedded=true</code>
            ）を設定すると、ここに iframe が表示されます。
          </p>
        </div>
      )}
    </div>
  </div>
</section>
