---
import { Image } from 'astro:assets';
import type { SiteMeta } from '../lib/sites';
import { telHref } from '../lib/sites';
import heroImage from '../assets/images/hero.jpg';

interface Props {
  site: SiteMeta;
}

const { site } = Astro.props;
const cta = site.ctaCopy;
const phone = site.phone;
const trustBadges = site.trustBadges ?? [];
---

<section class="bg-primary-50 px-4 py-8 sm:py-12">
  <div class="mx-auto grid max-w-5xl gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,480px)] lg:items-center">
    <div>
      <p class="text-sm font-semibold text-primary-700">
        {site.city}・{site.niche}
      </p>
      <h1 class="mt-2 text-2xl font-bold leading-tight text-primary-900 sm:text-3xl lg:text-4xl">
        {site.city}の<br class="sm:hidden" />
        <span class="text-primary-700">【{site.niche}】</span>専門
      </h1>

      <p class="mt-4 text-lg font-bold text-ink sm:text-xl">
        1台目 9,800円〜（税込）／2台目以降 8,800円〜
      </p>
      <p class="mt-1 text-xs text-ink-muted">
        ※ 壁掛け（お掃除機能なし）の料金。出張費・養生費・処分費すべて込み。
      </p>

      {trustBadges.length > 0 && (
        <ul class="mt-6 grid grid-cols-3 gap-2 sm:gap-3">
          {trustBadges.map((b) => (
            <li class="rounded-lg border border-primary-100 bg-white px-3 py-3 text-center shadow-sm">
              <span class="block text-[11px] text-ink-muted sm:text-xs">{b.label}</span>
              <span class="mt-0.5 block text-sm font-bold text-trust sm:text-base">{b.value}</span>
            </li>
          ))}
        </ul>
      )}

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:gap-4">
        <a
          href={telHref(phone)}
          class="inline-flex flex-col items-center justify-center rounded-lg bg-accent-500 px-5 py-3 text-center text-white shadow hover:bg-accent-600"
          aria-label={`電話で相談する ${phone}`}
        >
          <span class="text-xs">{cta?.phonePrimary ?? '電話で相談'}</span>
          <span class="text-lg font-bold">{phone}</span>
          <span class="text-[11px] opacity-90">{cta?.phoneSecondary ?? site.phoneHoursLabel}</span>
        </a>
        <a
          href="#contact"
          class="inline-flex flex-1 items-center justify-center rounded-lg bg-primary-700 px-5 py-3 text-center text-base font-bold text-white shadow hover:bg-primary-900"
        >
          {cta?.formPrimary ?? '30秒で見積もり依頼'}
        </a>
      </div>
    </div>

    <div class="relative overflow-hidden rounded-xl shadow-lg">
      <Image
        src={heroImage}
        alt={`${site.city}のエアコン分解洗浄サービスのイメージ`}
        loading="eager"
        decoding="async"
        fetchpriority="high"
        widths={[480, 768, 1280, 1920]}
        sizes="(max-width: 1024px) 100vw, 480px"
        class="block aspect-[16/9] h-auto w-full object-cover"
      />
    </div>
  </div>
</section>
