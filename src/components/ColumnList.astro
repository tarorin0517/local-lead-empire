---
import { getCollection } from 'astro:content';
import type { SiteMeta } from '../lib/sites';
import { resolveEntry, buildUrlPath } from '../lib/sites';

interface Props {
  site: SiteMeta;
}

const { site } = Astro.props;

const allEntries = await getCollection('sites', (entry) => !entry.data.draft);

const columns = allEntries
  .filter((entry) => {
    const resolved = resolveEntry(entry.id);
    return (
      resolved &&
      resolved.site.siteKey === site.siteKey &&
      entry.data.pageType === 'column'
    );
  })
  .map((entry) => {
    const resolved = resolveEntry(entry.id)!;
    return {
      title: entry.data.title,
      description: entry.data.description,
      url: buildUrlPath(site, resolved.relativePath),
      pubDate: entry.data.pubDate,
    };
  })
  .sort((a, b) => a.title.localeCompare(b.title, 'ja'));
---

{columns.length > 0 && (
  <section class="bg-gray-50 px-4 py-12">
    <div class="mx-auto max-w-3xl">
      <h2 class="mb-6 text-xl font-bold text-primary-900">
        {site.city}の{site.niche}｜お役立ちコラム
      </h2>
      <ul class="space-y-3">
        {columns.map((col) => (
          <li>
            <a
              href={col.url}
              class="block rounded-lg border border-gray-200 bg-white p-4 shadow-sm transition hover:border-primary-300 hover:shadow-md"
            >
              <p class="text-sm font-semibold text-primary-800 leading-snug">
                {col.title}
              </p>
              <p class="mt-1 text-xs text-ink-muted line-clamp-2 leading-relaxed">
                {col.description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
