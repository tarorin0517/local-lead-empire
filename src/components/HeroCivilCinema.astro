        <rect x="2464" y="100" width="5"   height="44"  fill="#07101c"/>
        <circle cx="2466" cy="98" r="3" fill="#cc2020" opacity="0.80"/>
        <!-- M19: 低層薄窓 -->
        <rect x="2555" y="230" width="140" height="230" fill="#121e2e"/>
        <rect x="2560" y="235" width="130" height="220" fill="url(#hcc-we)"/>
