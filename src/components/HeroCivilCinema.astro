        <rect x="914"  y="264" width="100" height="292" fill="url(#hcc-wa)"/>
        <rect x="930"  y="150" width="76"  height="115" fill="#07101b"/>
        <rect x="934"  y="154" width="68"  height="107" fill="url(#hcc-wa)"/>
        <!-- B12: 超高層スリム -->
        <rect x="1028" y="50"  width="60"  height="510" fill="#060e19"/>
        <rect x="1031" y="54"  width="54"  height="502" fill="url(#hcc-wb)"/>
        <rect x="1055" y="14"  width="5"   height="40"  fill="#040810"/>
        <circle cx="1057" cy="12" r="3" fill="#cc2020" opacity="0.90"/>
        <!-- B13: 中層消灯 -->
        <rect x="1096" y="230" width="85"  height="330" fill="#0a1520"/>
        <rect x="1100" y="234" width="77"  height="322" fill="url(#hcc-woff)"/>
        <!-- B14: 標準タワー -->
        <rect x="1190" y="110" width="95"  height="450" fill="#07101b"/>
        <rect x="1194" y="114" width="87"  height="442" fill="url(#hcc-wb)"/>
        <rect x="1234" y="74"  width="4"   height="40"  fill="#05090f"/>
        <circle cx="1236" cy="72" r="2.5" fill="#cc2020" opacity="0.80"/>
        <!-- B15: 幅狭 -->
        <rect x="1294" y="290" width="72"  height="270" fill="#0b1521"/>
        <rect x="1298" y="294" width="64"  height="262" fill="url(#hcc-wa)"/>
        <!-- B16: ガラスタワー -->
        <rect x="1375" y="130" width="105" height="430" fill="#08121e"/>
        <rect x="1379" y="134" width="97"  height="422" fill="url(#hcc-wb)"/>
        <rect x="1424" y="90"  width="5"   height="44"  fill="#040810"/>
        <circle cx="1426" cy="88" r="2.5" fill="#cc2020" opacity="0.80"/>
        <!-- B17: 段付き大型 -->
        <rect x="1490" y="200" width="120" height="360" fill="#07101b"/>
        <rect x="1494" y="204" width="112" height="352" fill="url(#hcc-wa)"/>
        <rect x="1510" y="90"  width="88"  height="115" fill="#07101b"/>
        <rect x="1514" y="94"  width="80"  height="107" fill="url(#hcc-wa)"/>
        <!-- B18: スリム明 -->
        <rect x="1620" y="160" width="55"  height="400" fill="#07101c"/>
        <rect x="1623" y="164" width="49"  height="392" fill="url(#hcc-wb)"/>
        <rect x="1644" y="126" width="4"   height="38"  fill="#05090f"/>
        <!-- B19: 中層 消灯 -->
        <rect x="1685" y="270" width="90"  height="290" fill="#0a1520"/>
        <rect x="1689" y="274" width="82"  height="282" fill="url(#hcc-woff)"/>
        <!-- B20: 高層 -->
        <rect x="1785" y="80"  width="85"  height="480" fill="#060f1a"/>
        <rect x="1789" y="84"  width="77"  height="472" fill="url(#hcc-wb)"/>
        <rect x="1824" y="44"  width="5"   height="40"  fill="#040810"/>
        <circle cx="1826" cy="42" r="3" fill="#cc2020" opacity="0.85"/>
        <!-- B21: 低層右端 -->
        <rect x="1880" y="320" width="95"  height="240" fill="#0b1522"/>
        <rect x="1884" y="324" width="87"  height="232" fill="url(#hcc-wa)"/>
        <!-- B22: 標準タワー -->
        <rect x="1985" y="150" width="88"  height="410" fill="#07101b"/>
        <rect x="1989" y="154" width="80"  height="402" fill="url(#hcc-wb)"/>
        <rect x="2025" y="112" width="4"   height="42"  fill="#05090f"/>
        <circle cx="2027" cy="110" r="2.5" fill="#cc2020" opacity="0.75"/>
        <!-- B23: 段付き -->
        <rect x="2082" y="230" width="100" height="330" fill="#08121d"/>
        <rect x="2086" y="234" width="92"  height="322" fill="url(#hcc-wa)"/>
        <rect x="2100" y="130" width="72"  height="104" fill="#07101b"/>
        <rect x="2104" y="134" width="64"  height="96"  fill="url(#hcc-wa)"/>
        <!-- B24: 超高層右端 -->
        <rect x="2192" y="40"  width="78"  height="520" fill="#060e19"/>
        <rect x="2196" y="44"  width="70"  height="512" fill="url(#hcc-wb)"/>
        <rect x="2227" y="6"   width="5"   height="38"  fill="#040810"/>
        <circle cx="2229" cy="4" r="3" fill="#cc2020" opacity="0.90"/>
        <!-- B25: 右端埋め -->
        <rect x="2280" y="200" width="120" height="360" fill="#0a1520"/>
        <rect x="2284" y="204" width="112" height="352" fill="url(#hcc-wa)"/>

        <!-- 散在する個別点灯窓 -->
        <rect x="340"  y="255" width="10" height="6"  fill="#f0b030" opacity="0.85"/>
        <rect x="365"  y="285" width="10" height="6"  fill="#f0b030" opacity="0.70"/>
        <rect x="614"  y="120" width="12" height="7"  fill="#c0d8f0" opacity="0.90"/>
        <rect x="638"  y="185" width="12" height="7"  fill="#c0d8f0" opacity="0.75"/>
        <rect x="1040" y="94"  width="10" height="6"  fill="#c0d8f0" opacity="0.85"/>
        <rect x="1206" y="160" width="10" height="6"  fill="#c0d8f0" opacity="0.80"/>
        <rect x="1392" y="205" width="12" height="7"  fill="#d0e8f8" opacity="0.70"/>
        <rect x="1516" y="124" width="10" height="6"  fill="#f0b030" opacity="0.80"/>
        <rect x="1800" y="130" width="12" height="7"  fill="#c0d8f0" opacity="0.85"/>
        <rect x="2002" y="198" width="10" height="6"  fill="#c0d8f0" opacity="0.80"/>
        <rect x="2205" y="80"  width="12" height="7"  fill="#c0d8f0" opacity="0.90"/>

        <!-- ===== スカイツリー風タワー（遠景・中央寄り） ===== -->
        <!-- 夜間ブルー照明グロー -->
        <ellipse cx="1600" cy="350" rx="40" ry="195" fill="#0048b0" opacity="0.040"/>
        <!-- 基部：末広がりの3本脚（2D側面表現） -->
        <polygon points="1565,560 1592,485 1608,485 1635,560" fill="#09182e"/>
        <!-- 基部左補助脚 -->
        <polygon points="1565,560 1590,560 1592,485 1580,485" fill="#0a1c34" opacity="0.60"/>
        <!-- メインシャフト（わずかにテーパー） -->
        <polygon points="1592,485 1595,110 1605,110 1608,485" fill="#0a1a32"/>
        <!-- 第1展望台 Tembo Deck（y≈265） -->
        <rect x="1582" y="254" width="36" height="15" rx="3.5" fill="#091830"/>
        <rect x="1582" y="252" width="36" height="5"  rx="2"   fill="#1244b0" opacity="0.55"/>
        <!-- 第2展望台 Tembo Galleria（y≈174） -->
        <rect x="1587" y="165" width="26" height="12" rx="3"   fill="#091830"/>
        <rect x="1587" y="163" width="26" height="4"  rx="2"   fill="#1040a0" opacity="0.45"/>
        <!-- 上部マスト -->
        <rect x="1597" y="26" width="6" height="88" fill="#08162c"/>
        <!-- アンテナ先端 -->
        <polygon points="1597,26 1600,12 1603,26" fill="#07122a"/>
        <!-- 航空障害灯 -->
        <circle cx="1600" cy="14"  r="3"   fill="#ff2020" opacity="0.92"/>
        <circle cx="1600" cy="110" r="2"   fill="#ff2020" opacity="0.55"/>
        <circle cx="1600" cy="258" r="1.5" fill="#3060ff" opacity="0.65"/>
      </svg>
    </div>

    <!-- ビル中景レイヤー -->
    <div class="hcc-layer" id="hcc-mid" aria-hidden="true">
      <svg class="hcc-svg hcc-svg-mid" viewBox="0 0 2800 460" preserveAspectRatio="xMinYMax meet" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="hcc-wc" x="0" y="0" width="20" height="17" patternUnits="userSpaceOnUse">
            <rect x="3" y="3" width="11" height="8" fill="#d88a12" opacity="0.72"/>
          </pattern>
          <pattern id="hcc-wd" x="0" y="0" width="22" height="19" patternUnits="userSpaceOnUse">
            <rect x="4" y="4" width="12" height="9" fill="#5898d0" opacity="0.58"/>
          </pattern>
          <pattern id="hcc-we" x="0" y="0" width="26" height="22" patternUnits="userSpaceOnUse">
            <rect x="5" y="5" width="14" height="10" fill="#7ab0e0" opacity="0.30"/>
          </pattern>
        </defs>

        <!-- M1: 低層幅広 -->
        <rect x="0"    y="240" width="140" height="220" fill="#111f30"/>
        <rect x="5"    y="245" width="130" height="210" fill="url(#hcc-wc)"/>
        <!-- M2: 段付き大型タワー -->
        <rect x="150"  y="160" width="165" height="300" fill="#0e1b2a"/>
        <rect x="155"  y="165" width="155" height="290" fill="url(#hcc-wd)"/>
        <rect x="170"  y="60"  width="130" height="105" fill="#0e1b2a"/>
        <rect x="175"  y="65"  width="120" height="95"  fill="url(#hcc-wd)"/>
        <rect x="232"  y="20"  width="5"   height="44"  fill="#08111c"/>
        <circle cx="234" cy="18" r="3" fill="#cc2020" opacity="0.90"/>
        <!-- M3: 中層 -->
        <rect x="325"  y="200" width="120" height="260" fill="#121e2e"/>
        <rect x="330"  y="205" width="110" height="250" fill="url(#hcc-wc)"/>
        <!-- M4: 超高層スリム -->
        <rect x="455"  y="40"  width="80"  height="420" fill="#0b1826"/>
        <rect x="459"  y="44"  width="72"  height="412" fill="url(#hcc-wd)"/>
        <rect x="492"  y="6"   width="5"   height="38"  fill="#07101c"/>
        <circle cx="494" cy="4" r="3" fill="#cc2020" opacity="0.90"/>
        <!-- M5: ガラスカーテンウォール（薄窓） -->
        <rect x="545"  y="190" width="145" height="270" fill="#101d2c"/>
        <rect x="550"  y="195" width="135" height="260" fill="url(#hcc-we)"/>
        <!-- M6: 段付きガラスタワー -->
        <rect x="700"  y="140" width="130" height="320" fill="#0e1b2a"/>
        <rect x="705"  y="145" width="120" height="310" fill="url(#hcc-wd)"/>
        <rect x="720"  y="50"  width="90"  height="95"  fill="#0d1929"/>
        <rect x="725"  y="55"  width="80"  height="85"  fill="url(#hcc-wd)"/>
        <rect x="762"  y="14"  width="5"   height="40"  fill="#08111c"/>
        <circle cx="764" cy="12" r="3" fill="#cc2020" opacity="0.85"/>
        <!-- M7: 中層 -->
        <rect x="840"  y="210" width="110" height="250" fill="#121e2e"/>
        <rect x="845"  y="215" width="100" height="240" fill="url(#hcc-wc)"/>
        <!-- M8: 幅広低層 -->
        <rect x="960"  y="280" width="190" height="180" fill="#111f30"/>
        <rect x="965"  y="285" width="180" height="170" fill="url(#hcc-wc)"/>
        <!-- M9: 高層ガラス -->
        <rect x="1160" y="100" width="120" height="360" fill="#0e1b2a"/>
        <rect x="1165" y="105" width="110" height="350" fill="url(#hcc-wd)"/>
        <rect x="1217" y="64"  width="5"   height="40"  fill="#07101c"/>
        <circle cx="1219" cy="62" r="3" fill="#cc2020" opacity="0.85"/>
        <!-- M10: 段付き中型 -->
        <rect x="1290" y="180" width="150" height="280" fill="#101d2c"/>
        <rect x="1295" y="185" width="140" height="270" fill="url(#hcc-wc)"/>
        <rect x="1310" y="80"  width="110" height="104" fill="#0e1b2a"/>
        <rect x="1315" y="85"  width="100" height="94"  fill="url(#hcc-wc)"/>
        <!-- M11: ガラスタワー高層 -->
        <rect x="1450" y="60"  width="100" height="400" fill="#0c1826"/>
        <rect x="1454" y="64"  width="92"  height="392" fill="url(#hcc-wd)"/>
        <rect x="1497" y="24"  width="5"   height="40"  fill="#07101c"/>
        <circle cx="1499" cy="22" r="3" fill="#cc2020" opacity="0.90"/>
        <!-- M12: 低中層 薄窓 -->
        <rect x="1560" y="220" width="125" height="240" fill="#111f30"/>
        <rect x="1565" y="225" width="115" height="230" fill="url(#hcc-we)"/>
        <!-- M13: 幅広低層 -->
        <rect x="1695" y="250" width="175" height="210" fill="#121e2e"/>
        <rect x="1700" y="255" width="165" height="200" fill="url(#hcc-wc)"/>
        <!-- M14: 高層タワー -->
        <rect x="1880" y="80"  width="110" height="380" fill="#0e1b2a"/>
        <rect x="1885" y="85"  width="100" height="370" fill="url(#hcc-wd)"/>
        <rect x="1932" y="44"  width="5"   height="40"  fill="#07101c"/>
        <circle cx="1934" cy="42" r="3" fill="#cc2020" opacity="0.85"/>
        <!-- M15: 段付き -->
        <rect x="2000" y="170" width="140" height="290" fill="#101d2c"/>
        <rect x="2005" y="175" width="130" height="280" fill="url(#hcc-wc)"/>
        <rect x="2020" y="70"  width="100" height="104" fill="#0e1b2a"/>
        <rect x="2025" y="75"  width="90"  height="94"  fill="url(#hcc-wc)"/>
        <!-- M16: 超高層 -->
