---
/**
 * HeroCivilCinema — 映画のワンシーン風シネマティック Hero
 * スーツ姿の人物が都会のオフィス街を歩くスクロール連動アニメーション
 */
import type { SiteMeta } from '../lib/sites';
interface Props { site: SiteMeta; }
const { site } = Astro.props;
---

<div class="hcc-root" id="hcc-root">
  <div class="hcc-sticky" id="hcc-sticky">

    <!-- 空 -->
    <div class="hcc-sky" aria-hidden="true"></div>

    <!-- ビル遠景レイヤー（最も遅い） -->
    <div class="hcc-layer" id="hcc-far" aria-hidden="true">
      <svg class="hcc-svg hcc-svg-far" viewBox="0 0 2400 560" preserveAspectRatio="xMinYMax meet" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="hcc-wa" x="0" y="0" width="14" height="12" patternUnits="userSpaceOnUse">
            <rect x="2" y="2" width="8" height="6" fill="#bf7a08" opacity="0.55"/>
          </pattern>
          <pattern id="hcc-wb" x="0" y="0" width="16" height="14" patternUnits="userSpaceOnUse">
            <rect x="2" y="2" width="10" height="8" fill="#4e88c0" opacity="0.40"/>
          </pattern>
        </defs>
        <rect x="0"    y="200" width="120" height="360" fill="#0b1724"/>
        <rect x="5"    y="205" width="110" height="350" fill="url(#hcc-wa)"/>
        <rect x="140"  y="60"  width="105" height="500" fill="#091420"/>
        <rect x="145"  y="65"  width="95"  height="490" fill="url(#hcc-wb)"/>
        <rect x="270"  y="130" width="155" height="430" fill="#0d1927"/>
        <rect x="275"  y="135" width="145" height="420" fill="url(#hcc-wa)"/>
        <rect x="450"  y="50"  width="125" height="510" fill="#0a1520"/>
        <rect x="455"  y="55"  width="115" height="500" fill="url(#hcc-wb)"/>
        <rect x="610"  y="160" width="145" height="400" fill="#0e1c2a"/>
        <rect x="615"  y="165" width="135" height="390" fill="url(#hcc-wa)"/>
        <rect x="790"  y="80"  width="115" height="480" fill="#0c1826"/>
        <rect x="795"  y="85"  width="105" height="470" fill="url(#hcc-wb)"/>
        <rect x="940"  y="170" width="135" height="390" fill="#091420"/>
        <rect x="945"  y="175" width="125" height="380" fill="url(#hcc-wa)"/>
        <rect x="1110" y="40"  width="110" height="520" fill="#0d1927"/>
        <rect x="1115" y="45"  width="100" height="510" fill="url(#hcc-wb)"/>
        <rect x="1260" y="130" width="160" height="430" fill="#0a1520"/>
        <rect x="1265" y="135" width="150" height="420" fill="url(#hcc-wa)"/>
        <rect x="1460" y="70"  width="130" height="490" fill="#0c1826"/>
        <rect x="1465" y="75"  width="120" height="480" fill="url(#hcc-wb)"/>
        <rect x="1640" y="150" width="145" height="410" fill="#0e1c2a"/>
        <rect x="1645" y="155" width="135" height="400" fill="url(#hcc-wa)"/>
        <rect x="1830" y="60"  width="120" height="500" fill="#091420"/>
        <rect x="1835" y="65"  width="110" height="490" fill="url(#hcc-wb)"/>
        <rect x="2010" y="110" width="150" height="450" fill="#0d1927"/>
        <rect x="2015" y="115" width="140" height="440" fill="url(#hcc-wa)"/>
        <rect x="2210" y="80"  width="135" height="480" fill="#0a1520"/>
        <rect x="2215" y="85"  width="125" height="470" fill="url(#hcc-wb)"/>
      </svg>
    </div>

    <!-- ビル中景レイヤー -->
    <div class="hcc-layer" id="hcc-mid" aria-hidden="true">
      <svg class="hcc-svg hcc-svg-mid" viewBox="0 0 2800 460" preserveAspectRatio="xMinYMax meet" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="hcc-wc" x="0" y="0" width="18" height="16" patternUnits="userSpaceOnUse">
            <rect x="3" y="3" width="10" height="8" fill="#e09a20" opacity="0.70"/>
          </pattern>
          <pattern id="hcc-wd" x="0" y="0" width="20" height="18" patternUnits="userSpaceOnUse">
            <rect x="3" y="3" width="12" height="9" fill="#5b9bd5" opacity="0.55"/>
          </pattern>
        </defs>
        <rect x="0"    y="240" width="180" height="220" fill="#111f30"/>
        <rect x="5"    y="245" width="170" height="210" fill="url(#hcc-wc)"/>
        <rect x="200"  y="160" width="130" height="300" fill="#0e1b2a"/>
        <rect x="205"  y="165" width="120" height="290" fill="url(#hcc-wd)"/>
        <rect x="360"  y="200" width="190" height="260" fill="#121e2e"/>
        <rect x="365"  y="205" width="180" height="250" fill="url(#hcc-wc)"/>
        <rect x="580"  y="140" width="150" height="320" fill="#0e1b2a"/>
        <rect x="585"  y="145" width="140" height="310" fill="url(#hcc-wd)"/>
        <rect x="760"  y="190" width="170" height="270" fill="#111f30"/>
        <rect x="765"  y="195" width="160" height="260" fill="url(#hcc-wc)"/>
        <rect x="970"  y="160" width="140" height="300" fill="#0e1b2a"/>
        <rect x="975"  y="165" width="130" height="290" fill="url(#hcc-wd)"/>
        <rect x="1150" y="180" width="180" height="280" fill="#121e2e"/>
        <rect x="1155" y="185" width="170" height="270" fill="url(#hcc-wc)"/>
        <rect x="1380" y="150" width="155" height="310" fill="#0e1b2a"/>
        <rect x="1385" y="155" width="145" height="300" fill="url(#hcc-wd)"/>
        <rect x="1580" y="190" width="175" height="270" fill="#111f30"/>
        <rect x="1585" y="195" width="165" height="260" fill="url(#hcc-wc)"/>
        <rect x="1800" y="160" width="145" height="300" fill="#0e1b2a"/>
        <rect x="1805" y="165" width="135" height="290" fill="url(#hcc-wd)"/>
        <rect x="2000" y="180" width="185" height="280" fill="#121e2e"/>
        <rect x="2005" y="185" width="175" height="270" fill="url(#hcc-wc)"/>
        <rect x="2240" y="150" width="160" height="310" fill="#0e1b2a"/>
        <rect x="2245" y="155" width="150" height="300" fill="url(#hcc-wd)"/>
        <rect x="2460" y="170" width="175" height="290" fill="#111f30"/>
        <rect x="2465" y="175" width="165" height="280" fill="url(#hcc-wc)"/>
        <rect x="2700" y="140" width="150" height="320" fill="#0e1b2a"/>
        <rect x="2705" y="145" width="140" height="310" fill="url(#hcc-wd)"/>
      </svg>
    </div>

    <!-- 朝日の光芒 -->
    <div class="hcc-light" id="hcc-light" aria-hidden="true"></div>

    <!-- 地面・道路 -->
    <div class="hcc-ground" aria-hidden="true">
      <div class="hcc-road-line" aria-hidden="true"></div>
    </div>

    <!-- 歩行人物（リアルシルエット） -->
    <div class="hcc-person-wrap" id="hcc-person" aria-hidden="true">

      <!--
        viewBox: 0 0 72 144
        人体 y座標:
          頭頂   y=2
          頭中心 y=14  (ry=12)
          首     y=24-32
          肩     y=33
          胴体下 y=82
          股関節 y=82
          膝     y=112 (大腿長=30)
          足首   y=134 (脛長=22)
          靴底   y=142
      -->
      <svg class="hcc-walker" viewBox="0 0 72 144" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- スーツグラデーション（左から右へ暗く＝側面陰影） -->
          <linearGradient id="hcc-sg" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%"   stop-color="#1c3048"/>
            <stop offset="50%"  stop-color="#0e1f30"/>
            <stop offset="100%" stop-color="#07111c"/>
          </linearGradient>
          <!-- ズボングラデーション -->
          <linearGradient id="hcc-pg" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%"   stop-color="#1a2c40"/>
            <stop offset="50%"  stop-color="#0c1c2c"/>
            <stop offset="100%" stop-color="#060f1a"/>
          </linearGradient>
          <!-- バックライトグロー -->
          <filter id="hcc-glow">
            <feGaussianBlur in="SourceGraphic" stdDeviation="1.5" result="blur"/>
            <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
        </defs>

        <!-- ===== 奥側（遠い側）を先に描画 ===== -->

        <!-- 奥側 大腿+脛 (左脚) -->
        <g class="hcc-thigh-l">
          <!-- 大腿 -->
          <rect x="41" y="82" width="12" height="30" rx="5" fill="url(#hcc-pg)"/>
          <!-- ズボン折り目 -->
          <line x1="47" y1="84" x2="47" y2="111" stroke="#060f1a" stroke-width="0.9" opacity="0.6"/>
          <!-- 脛（膝から回転する入れ子グループ） -->
          <g class="hcc-calf-l">
            <rect x="42" y="112" width="10" height="22" rx="4" fill="url(#hcc-pg)"/>
            <!-- 靴（左） -->
            <path d="M34 134 C36 138 42 140 50 140 C58 140 62 137 62 134 L62 132 C58 133 50 134 44 133 C40 132 36 131 34 132 Z" fill="#040c14"/>
            <line x1="42" y1="134" x2="58" y2="134" stroke="#060e18" stroke-width="0.8" opacity="0.4"/>
          </g>
        </g>

        <!-- 奥側 上腕（左腕＋ブリーフケース） -->
        <g class="hcc-arm-l">
          <!-- 上腕 -->
          <rect x="53" y="33" width="9" height="24" rx="4.5" fill="url(#hcc-sg)"/>
          <!-- 前腕（袖口） -->
          <rect x="54" y="57" width="8" height="18" rx="3.5" fill="url(#hcc-sg)"/>
          <!-- 袖口カフ -->
          <rect x="54" y="72" width="8" height="3" rx="1.5" fill="#1e3454"/>
          <!-- 手 -->
          <ellipse cx="58" cy="77" rx="5.5" ry="4" fill="#0c1e30"/>
          <!-- ブリーフケース本体 -->
          <rect x="50" y="76" width="18" height="13" rx="2.5" fill="#122035"/>
          <!-- ブリーフケース金具 -->
          <rect x="56" y="74" width="8" height="5" rx="2" fill="#122035"/>
          <!-- 留め具 -->
          <rect x="57" y="81" width="6" height="3" rx="1" fill="#1e3454"/>
          <!-- ステッチ線 -->
          <rect x="51" y="77" width="16" height="11" rx="2" fill="none" stroke="#0d1a28" stroke-width="0.8"/>
        </g>

        <!-- ===== 胴体・頭部（中間層） ===== -->

        <!-- ジャケット本体（肩から股まで） -->
        <path d="M 20 33 Q 14 50 14 65 Q 14 76 18 82 L 54 82 Q 58 76 58 65 Q 58 50 52 33 Z"
              fill="url(#hcc-sg)"/>
        <!-- 左ラペル（手前側） -->
        <path d="M 36 36 L 44 43 L 40 64 L 36 60 Z" fill="#0a1824" opacity="0.65"/>
        <!-- 右ラペル（奥側） -->
        <path d="M 36 36 L 28 43 L 32 64 L 36 60 Z" fill="#07111e" opacity="0.45"/>
        <!-- シャツ白い三角 -->
        <path d="M 33 37 L 36 42 L 39 37 L 40 60 L 36 63 L 32 60 Z" fill="#0c1c2e"/>
        <!-- ネクタイ -->
        <path d="M 34.5 39 L 36 41 L 37.5 39 L 38.5 67 L 36 70 L 33.5 67 Z" fill="#060d1a"/>
        <!-- ジャケットボタン -->
        <circle cx="36" cy="73" r="1.5" fill="#0c1c2e"/>
        <!-- ポケットチーフ（左胸） -->
        <path d="M 42 40 L 48 38 L 48 46 L 44 47 Z" fill="#0f1e30" opacity="0.7"/>
        <!-- 体の側面陰影ライン -->
        <line x1="19" y1="38" x2="19" y2="80" stroke="#060f1a" stroke-width="1.2" opacity="0.3"/>

        <!-- 首 -->
        <rect x="32" y="24" width="8" height="10" rx="3" fill="#0c1e2e"/>
        <!-- Yシャツ衿 -->
        <path d="M 32 28 L 36 25 L 40 28" fill="none" stroke="#1a3050" stroke-width="1.5" stroke-linecap="round"/>

        <!-- 髪（頭の上に重なる楕円） -->
        <ellipse cx="36" cy="10" rx="13.5" ry="9" fill="#050d18"/>
        <!-- 頭部 -->
        <ellipse cx="36" cy="15" rx="11.5" ry="12" fill="#0d1e2e"/>
        <!-- 耳 -->
        <ellipse cx="24.5" cy="15" rx="2.5" ry="3.5" fill="#0a1828"/>
        <!-- 逆光リムライト（ゴールドアウトライン） -->
        <ellipse cx="36" cy="15" rx="11.5" ry="12"
                 fill="none" stroke="#c9982c" stroke-width="1.8" opacity="0.32"
                 filter="url(#hcc-glow)"/>
        <!-- 頭頂部ハイライト（朝日反射） -->
        <ellipse cx="38" cy="8" rx="5" ry="3" fill="rgba(201,152,44,0.08)"/>

        <!-- ===== 手前側（近い側）を最後に描画 ===== -->

        <!-- 手前側 大腿+脛 (右脚) -->
        <g class="hcc-thigh-r">
          <!-- 大腿 -->
          <rect x="19" y="82" width="12" height="30" rx="5" fill="url(#hcc-pg)"/>
          <!-- ズボン折り目 -->
          <line x1="25" y1="84" x2="25" y2="111" stroke="#060f1a" stroke-width="0.9" opacity="0.6"/>
          <!-- 脛（膝から回転する入れ子グループ） -->
          <g class="hcc-calf-r">
            <rect x="20" y="112" width="10" height="22" rx="4" fill="url(#hcc-pg)"/>
            <!-- 靴（右：手前側なのでより詳細） -->
            <path d="M10 134 C12 138 20 140 28 140 C36 140 40 137 40 134 L40 132 C36 133 28 134 22 133 C18 132 14 131 11 132 Z" fill="#040c14"/>
            <!-- 靴底ライン -->
            <line x1="12" y1="134" x2="38" y2="134" stroke="#060e18" stroke-width="0.8" opacity="0.5"/>
            <!-- ソールの厚み -->
            <path d="M10 134 C10 136 12 138 20 140 C28 140 38 138 40 136 L40 134" fill="none" stroke="#050c16" stroke-width="1"/>
          </g>
        </g>

        <!-- 手前側 上腕（右腕） -->
        <g class="hcc-arm-r">
          <!-- 上腕 -->
          <rect x="10" y="33" width="9" height="24" rx="4.5" fill="url(#hcc-sg)"/>
          <!-- 前腕 -->
          <rect x="11" y="57" width="8" height="18" rx="3.5" fill="url(#hcc-sg)"/>
          <!-- 袖口カフ -->
          <rect x="11" y="72" width="8" height="3" rx="1.5" fill="#1e3454"/>
          <!-- 手 -->
          <ellipse cx="15" cy="77" rx="5.5" ry="4" fill="#0c1e30"/>
        </g>

        <!-- 肩のラインを強調（上腕の付け根をなじませる） -->
        <ellipse cx="15" cy="35" rx="6" ry="4" fill="url(#hcc-sg)"/>
        <ellipse cx="57" cy="35" rx="6" ry="4" fill="url(#hcc-sg)"/>

      </svg>

      <!-- 地面の影 -->
      <div class="hcc-person-shadow" aria-hidden="true"></div>
    </div>

    <!-- ビル近景レイヤー（最速・ぼかし） -->
    <div class="hcc-layer hcc-layer-near" id="hcc-near" aria-hidden="true">
      <svg class="hcc-svg hcc-svg-near" viewBox="0 0 2000 380" preserveAspectRatio="xMinYMax meet" xmlns="http://www.w3.org/2000/svg">
        <rect x="0"    y="80"  width="240" height="300" fill="#0c1d2e"/>
        <rect x="260"  y="160" width="200" height="220" fill="#0f2035"/>
        <rect x="480"  y="100" width="180" height="280" fill="#0c1d2e"/>
        <rect x="1340" y="120" width="220" height="260" fill="#0c1d2e"/>
        <rect x="1580" y="80"  width="200" height="300" fill="#0f2035"/>
        <rect x="1800" y="140" width="200" height="240" fill="#0c1d2e"/>
      </svg>
    </div>

    <!-- フィルムグレイン -->
    <div class="hcc-grain" aria-hidden="true"></div>

    <!-- シネマスコープ レターボックス -->
    <div class="hcc-bar hcc-bar-top"    aria-hidden="true"></div>
    <div class="hcc-bar hcc-bar-bottom" aria-hidden="true"></div>

    <!-- テキストオーバーレイ -->
    <div class="hcc-text-wrap" id="hcc-text">
      <p class="hcc-eyebrow">公務員の信用力を武器に</p>
      <h1 class="hcc-headline">{site.tagline}</h1>
      <p class="hcc-sub">9室以下・届出不要・全国オンライン対応</p>
      <div class="hcc-badges">
        {(site.trustBadges ?? []).map(b => (
          <span class="hcc-badge">{b.label}<span class="hcc-badge-val">{b.value}</span></span>
        ))}
      </div>
    </div>

  </div>
</div>

<style>
/* ===== ROOT ===== */
.hcc-root {
  position: relative;
  height: 300vh;
  width: 100%;
}
.hcc-sticky {
  position: sticky;
  top: 0;
  height: 100svh;
  width: 100%;
  overflow: hidden;
  background: #040a12;
}

/* ===== SKY ===== */
.hcc-sky {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    #020810 0%,
    #061220 35%,
    #0a1a34 65%,
    #102248 100%
  );
}

/* ===== LAYERS ===== */
.hcc-layer {
  position: absolute;
  bottom: 18%;
  left: 0;
  will-change: transform;
}
.hcc-svg { display: block; }
.hcc-svg-far  { width: 240vw; height: auto; }
.hcc-svg-mid  { width: 280vw; height: auto; }
.hcc-svg-near { width: 200vw; height: auto; }

.hcc-layer-near {
  filter: blur(7px);
  bottom: 16%;
  opacity: 0.85;
}

/* ===== LIGHT RAYS ===== */
.hcc-light {
  position: absolute;
  top: 0;
  width: 480px;
  height: 100%;
  pointer-events: none;
  will-change: opacity, transform;
  opacity: 0;
  background:
    radial-gradient(ellipse 160px 280px at 50% 28%, rgba(201,152,44,.14) 0%, transparent 60%),
    radial-gradient(ellipse 80px  480px at 52% 0%,   rgba(201,152,44,.07) 0%, transparent 80%);
}

/* ===== GROUND ===== */
.hcc-ground {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 20%;
  background: linear-gradient(to bottom, #0a1825 0%, #050d18 100%);
  overflow: hidden;
}
.hcc-ground::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    transparent 20%,
    rgba(201,152,44,.025) 50%,
    transparent 80%
  );
}
.hcc-road-line {
  position: absolute;
  top: 35%;
  left: 0;
  width: 100%;
  height: 3px;
  background: repeating-linear-gradient(
    to right,
    transparent 0px 40px,
    rgba(255,255,255,.05) 40px 80px
  );
}

/* ===== WALKING PERSON ===== */
.hcc-person-wrap {
  position: absolute;
  bottom: 19%;
  left: 0;
  will-change: transform;
  transform-origin: 0 100%;
}
.hcc-walker {
  width: 90px;
  height: 180px;
  display: block;
  /* 逆光の雰囲気を強調するフィルタ */
  filter: drop-shadow(0 0 8px rgba(201,152,44,.22)) drop-shadow(0 4px 12px rgba(0,0,0,.6));
}
.hcc-person-shadow {
  position: absolute;
  bottom: -6px;
  left: 50%;
  transform: translateX(-50%);
  width: 70px;
  height: 12px;
  background: radial-gradient(ellipse, rgba(0,0,0,.55) 0%, transparent 70%);
  border-radius: 50%;
}

/* ===== 歩行アニメーション =====
   大腿は股関節で回転、脛は大腿グループ内で膝関節から回転。
   transform-box: fill-box → 要素自身のバウンディングボックスを基準に
   transform-origin: 50% 0% → バウンディングボックスの上端中央 = 関節位置
*/

/* 大腿 */
.hcc-thigh-r {
  transform-box: fill-box;
  transform-origin: 50% 0%;
  animation: hccThighR 0.64s ease-in-out infinite;
}
.hcc-thigh-l {
  transform-box: fill-box;
  transform-origin: 50% 0%;
  animation: hccThighL 0.64s ease-in-out infinite;
}
/* 脛（大腿グループ内で追加回転 → ひざの曲げ伸ばし） */
.hcc-calf-r {
  transform-box: fill-box;
  transform-origin: 50% 0%;
  animation: hccCalfR 0.64s ease-in-out infinite;
}
.hcc-calf-l {
  transform-box: fill-box;
  transform-origin: 50% 0%;
  animation: hccCalfL 0.64s ease-in-out infinite;
}
/* 腕 */
.hcc-arm-r {
  transform-box: fill-box;
  transform-origin: 50% 0%;
  animation: hccArmR 0.64s ease-in-out infinite;
}
.hcc-arm-l {
  transform-box: fill-box;
  transform-origin: 50% 0%;
  animation: hccArmL 0.64s ease-in-out infinite;
}
/* 全身の上下ボブ */
.hcc-walker {
  animation: hccBob 0.32s ease-in-out infinite alternate;
}

@keyframes hccThighR {
  0%, 100% { transform: rotate(-24deg); }
  50%       { transform: rotate(24deg);  }
}
@keyframes hccThighL {
  0%, 100% { transform: rotate(24deg);  }
  50%       { transform: rotate(-24deg); }
}
/*
  脛のひざ曲げ：
  前振り時（大腿が前に出るとき）= ひざが曲がって脛が後ろ気味 → 負の角度を大きく
  体の真下（着地）= ひざほぼ伸びる → 角度ゼロ付近
  後振り時 = 少しだけ曲がる
*/
@keyframes hccCalfR {
  0%   { transform: rotate(-14deg); }
  20%  { transform: rotate(-2deg);  }
  50%  { transform: rotate(-10deg); }
  80%  { transform: rotate(-2deg);  }
  100% { transform: rotate(-14deg); }
}
@keyframes hccCalfL {
  0%   { transform: rotate(-10deg); }
  20%  { transform: rotate(-2deg);  }
  50%  { transform: rotate(-14deg); }
  80%  { transform: rotate(-2deg);  }
  100% { transform: rotate(-10deg); }
}
@keyframes hccArmR {
  0%, 100% { transform: rotate(18deg);  }
  50%       { transform: rotate(-18deg); }
}
@keyframes hccArmL {
  0%, 100% { transform: rotate(-14deg); }
  50%       { transform: rotate(14deg);  }
}
@keyframes hccBob {
  from { transform: translateY(0px); }
  to   { transform: translateY(-4px); }
}

/* ===== FILM GRAIN ===== */
.hcc-grain {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .038;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23g)'/%3E%3C/svg%3E");
  background-size: 200px 200px;
  mix-blend-mode: overlay;
}

/* ===== LETTERBOX ===== */
.hcc-bar {
  position: absolute;
  left: 0;
  width: 100%;
