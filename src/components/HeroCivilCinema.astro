---
/**
 * HeroCivilCinema — 映画的シネマティック Hero（都市景観パン）
 * 人物なし。リアルなオフィス街のスクロール視差アニメーション。
 */
import type { SiteMeta } from '../lib/sites';
interface Props { site: SiteMeta; }
const { site } = Astro.props;
---

<div class="hcc-root" id="hcc-root">
  <div class="hcc-sticky" id="hcc-sticky">

    <!-- 夜明け前の空 -->
    <div class="hcc-sky" aria-hidden="true"></div>
    <!-- 地平線の夜明けグロー -->
    <div class="hcc-horizon" aria-hidden="true"></div>

    <!-- ビル遠景レイヤー -->
    <div class="hcc-layer" id="hcc-far" aria-hidden="true">
      <svg class="hcc-svg hcc-svg-far" viewBox="0 0 2400 560" preserveAspectRatio="xMinYMax meet" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- 温色窓（稼働中オフィス） -->
          <pattern id="hcc-wa" x="0" y="0" width="16" height="13" patternUnits="userSpaceOnUse">
            <rect x="2" y="2" width="9" height="6" fill="#c87808" opacity="0.60"/>
          </pattern>
          <!-- 冷色窓（ガラスカーテンウォール） -->
          <pattern id="hcc-wb" x="0" y="0" width="18" height="15" patternUnits="userSpaceOnUse">
            <rect x="3" y="3" width="10" height="7" fill="#4880b8" opacity="0.44"/>
          </pattern>
          <!-- 消灯気味の窓 -->
          <pattern id="hcc-woff" x="0" y="0" width="22" height="18" patternUnits="userSpaceOnUse">
            <rect x="4" y="4" width="12" height="8" fill="#2a4a70" opacity="0.18"/>
          </pattern>
        </defs>

        <!-- B1: 低層ブロック -->
        <rect x="0"    y="330" width="88"  height="230" fill="#0a1522"/>
        <rect x="4"    y="334" width="80"  height="222" fill="url(#hcc-wa)"/>
        <!-- B2: 中高層タワー -->
        <rect x="95"   y="180" width="68"  height="380" fill="#07101b"/>
        <rect x="99"   y="184" width="60"  height="372" fill="url(#hcc-wb)"/>
        <rect x="128"  y="143" width="4"   height="41"  fill="#05090f"/>
        <circle cx="130" cy="141" r="2.5" fill="#cc2020" opacity="0.80"/>
        <!-- B3: スリムタワー -->
        <rect x="170"  y="100" width="44"  height="460" fill="#07101c"/>
        <rect x="173"  y="104" width="38"  height="452" fill="url(#hcc-wb)"/>
        <rect x="190"  y="64"  width="4"   height="40"  fill="#05090f"/>
        <circle cx="192" cy="62" r="2.5" fill="#cc2020" opacity="0.75"/>
        <!-- B4: 幅広低層 -->
        <rect x="220"  y="300" width="100" height="260" fill="#0b1522"/>
        <rect x="224"  y="304" width="92"  height="252" fill="url(#hcc-wa)"/>
        <!-- B5: 段付きタワー（setback） -->
        <rect x="328"  y="240" width="110" height="320" fill="#08111c"/>
        <rect x="332"  y="244" width="102" height="312" fill="url(#hcc-wb)"/>
        <rect x="348"  y="120" width="74"  height="125" fill="#07101b"/>
        <rect x="352"  y="124" width="66"  height="117" fill="url(#hcc-wb)"/>
        <rect x="382"  y="68"  width="4"   height="56"  fill="#05090f"/>
        <circle cx="384" cy="66" r="2.5" fill="#cc2020" opacity="0.80"/>
        <!-- B6: 中層 温色 -->
        <rect x="445"  y="200" width="88"  height="360" fill="#0a1520"/>
        <rect x="449"  y="204" width="80"  height="352" fill="url(#hcc-wa)"/>
        <!-- B7: スリム消灯気味 -->
        <rect x="540"  y="170" width="50"  height="390" fill="#07101b"/>
        <rect x="543"  y="174" width="44"  height="382" fill="url(#hcc-woff)"/>
        <!-- B8: 大型ガラスタワー -->
        <rect x="598"  y="70"  width="115" height="490" fill="#060f1a"/>
        <rect x="602"  y="74"  width="107" height="482" fill="url(#hcc-wb)"/>
        <rect x="652"  y="36"  width="5"   height="38"  fill="#040810"/>
        <circle cx="654" cy="34" r="3" fill="#cc2020" opacity="0.85"/>
        <!-- B9: 低層ブロック -->
        <rect x="722"  y="340" width="92"  height="220" fill="#0b1521"/>
        <rect x="726"  y="344" width="84"  height="212" fill="url(#hcc-wa)"/>
        <!-- B10: 中高層 -->
        <rect x="823"  y="140" width="78"  height="420" fill="#07101b"/>
        <rect x="827"  y="144" width="70"  height="412" fill="url(#hcc-wb)"/>
        <rect x="860"  y="100" width="4"   height="44"  fill="#05090f"/>
