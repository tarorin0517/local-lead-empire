        <rect x="2160" y="62"  width="14" height="8" fill="#c0d8f0" opacity="0.90"/>

        <!-- ===== 東京タワー風鉄塔 ===== -->
        <!-- 夜間オレンジ照明の環境グロー -->
        <ellipse cx="1360" cy="300" rx="80" ry="175" fill="#d06010" opacity="0.048"/>
        <!-- 左脚（広がり） -->
        <polygon points="1308,460 1334,380 1342,380 1323,460" fill="#c84000"/>
        <!-- 右脚（広がり） -->
        <polygon points="1412,460 1397,460 1378,380 1386,380" fill="#c84000"/>
        <!-- 下部ボディ（脚結合〜第1展望台） -->
        <polygon points="1334,380 1339,295 1381,295 1386,380" fill="#bf3c00"/>
        <!-- 構造横桁 -->
        <line x1="1315" y1="422" x2="1405" y2="422" stroke="#9c3000" stroke-width="2.5"/>
        <line x1="1320" y1="402" x2="1400" y2="402" stroke="#9c3000" stroke-width="2.0"/>
        <line x1="1326" y1="382" x2="1394" y2="382" stroke="#9c3000" stroke-width="1.8"/>
        <line x1="1331" y1="362" x2="1389" y2="362" stroke="#903000" stroke-width="1.4"/>
        <line x1="1334" y1="342" x2="1386" y2="342" stroke="#903000" stroke-width="1.2"/>
        <line x1="1335" y1="322" x2="1385" y2="322" stroke="#883000" stroke-width="1.0"/>
        <!-- 第1展望台プラットフォーム -->
        <rect x="1318" y="284" width="84" height="13" rx="2.5" fill="#9c3000"/>
        <rect x="1318" y="282" width="84" height="4"  fill="#c84000"/>
        <!-- 中部ボディ（第1〜第2展望台） -->
        <polygon points="1339,284 1344,190 1376,190 1381,284" fill="#bf3c00"/>
        <!-- 中部横桁 -->
        <line x1="1337" y1="266" x2="1383" y2="266" stroke="#903000" stroke-width="1.2"/>
        <line x1="1339" y1="248" x2="1381" y2="248" stroke="#883000" stroke-width="1.0"/>
        <line x1="1340" y1="228" x2="1380" y2="228" stroke="#883000" stroke-width="0.9"/>
        <line x1="1342" y1="210" x2="1378" y2="210" stroke="#802c00" stroke-width="0.8"/>
        <!-- 第2展望台プラットフォーム -->
        <rect x="1330" y="179" width="60" height="13" rx="2" fill="#9c3000"/>
        <rect x="1330" y="177" width="60" height="4"  fill="#c04000"/>
        <!-- 上部ボディ（第2展望台〜アンテナ基部） -->
        <polygon points="1344,179 1350,80 1370,80 1376,179" fill="#bf3c00"/>
        <!-- 上部横桁 -->
        <line x1="1343" y1="162" x2="1377" y2="162" stroke="#882c00" stroke-width="0.9"/>
        <line x1="1345" y1="144" x2="1375" y2="144" stroke="#882c00" stroke-width="0.8"/>
        <line x1="1347" y1="126" x2="1373" y2="126" stroke="#802800" stroke-width="0.7"/>
        <line x1="1348" y1="108" x2="1372" y2="108" stroke="#802800" stroke-width="0.6"/>
        <!-- アンテナポール -->
        <rect x="1356" y="17" width="8" height="67" fill="#9c3000"/>
        <!-- アンテナ先端 -->
        <polygon points="1356,17 1360,3 1364,17" fill="#883000"/>
        <!-- 航空障害灯（赤点滅） -->
        <circle cx="1360" cy="5"   r="3.5" fill="#ff2020" opacity="0.92"/>
        <circle cx="1360" cy="88"  r="2.5" fill="#ff2020" opacity="0.65"/>
        <circle cx="1360" cy="184" r="2.0" fill="#ff4020" opacity="0.48"/>
      </svg>
    </div>

    <!-- 朝日の光芒 -->
    <div class="hcc-light" id="hcc-light" aria-hidden="true"></div>

    <!-- 地面（濡れたアスファルト） -->
    <div class="hcc-ground" aria-hidden="true">
      <div class="hcc-reflect" aria-hidden="true"></div>
      <div class="hcc-marking" aria-hidden="true"></div>
    </div>

    <!-- ビル近景（暗いシルエット＋ぼかし） -->
    <div class="hcc-layer hcc-layer-near" id="hcc-near" aria-hidden="true">
      <svg class="hcc-svg hcc-svg-near" viewBox="0 0 2000 380" preserveAspectRatio="xMinYMax meet" xmlns="http://www.w3.org/2000/svg">
        <!-- 近景は暗い不透明シルエット -->
        <rect x="0"    y="60"  width="220" height="320" fill="#0b1d2e"/>
        <rect x="230"  y="130" width="180" height="250" fill="#091828"/>
        <rect x="420"  y="80"  width="155" height="300" fill="#0b1d2e"/>
        <!-- 中央：道路方向の開口（奥行き感） -->
        <rect x="1280" y="100" width="200" height="280" fill="#0b1d2e"/>
        <rect x="1490" y="60"  width="175" height="320" fill="#091828"/>
        <rect x="1680" y="110" width="155" height="270" fill="#0b1d2e"/>
        <rect x="1850" y="75"  width="150" height="305" fill="#091828"/>
      </svg>
    </div>

    <!-- 大気散乱ヘイズ -->
    <div class="hcc-haze" aria-hidden="true"></div>

    <!-- フィルムグレイン -->
    <div class="hcc-grain" aria-hidden="true"></div>

    <!-- シネマスコープ レターボックス -->
    <div class="hcc-bar hcc-bar-top"    aria-hidden="true"></div>
    <div class="hcc-bar hcc-bar-bottom" aria-hidden="true"></div>

    <!-- テキストオーバーレイ -->
    <div class="hcc-text-wrap" id="hcc-text">
      <p class="hcc-eyebrow">公務員の信用力を武器に</p>
      <h1 class="hcc-headline">{site.tagline}</h1>
      <p class="hcc-sub">9室以下・届出不要・全国オンライン対応</p>
      <div class="hcc-badges">
        {(site.trustBadges ?? []).map(b => (
          <span class="hcc-badge">{b.label}<span class="hcc-badge-val">{b.value}</span></span>
        ))}
      </div>
    </div>

  </div>
</div>

<style>
/* ===== ROOT ===== */
.hcc-root {
  position: relative;
  height: 300vh;
  width: 100%;
}
.hcc-sticky {
  position: sticky;
  top: 0;
  height: 100svh;
  width: 100%;
  overflow: hidden;
  background: #040a12;
}

/* ===== SKY ===== */
.hcc-sky {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    #020710 0%,
    #05101e 30%,
    #081830 60%,
    #0d2040 100%
  );
}
/* 地平線の夜明けグロー */
.hcc-horizon {
  position: absolute;
  bottom: 18%;
  left: 0;
  width: 100%;
  height: 28%;
  pointer-events: none;
  background: linear-gradient(
    to top,
    rgba(180, 85, 15, 0.20) 0%,
    rgba(130, 60, 10, 0.09) 40%,
    transparent 100%
  );
}

/* ===== LAYERS ===== */
.hcc-layer {
  position: absolute;
  bottom: 18%;
  left: 0;
  will-change: transform;
}
.hcc-svg { display: block; }
.hcc-svg-far  { width: 240vw; height: auto; }
.hcc-svg-mid  { width: 280vw; height: auto; }
.hcc-svg-near { width: 200vw; height: auto; }

.hcc-layer-near {
  filter: blur(6px);
  bottom: 16%;
  opacity: 0.90;
}

/* ===== LIGHT RAYS ===== */
.hcc-light {
  position: absolute;
  top: 0;
  width: 520px;
  height: 100%;
  pointer-events: none;
  will-change: opacity, transform;
  opacity: 0;
  background:
    radial-gradient(ellipse 200px 360px at 50% 32%, rgba(210,130,30,.16) 0%, transparent 60%),
    radial-gradient(ellipse 90px  500px at 52% 0%,  rgba(210,130,30,.08) 0%, transparent 80%),
    radial-gradient(ellipse 400px 100px at 50% 40%, rgba(180,100,20,.06) 0%, transparent 70%);
}

/* ===== GROUND（濡れアスファルト） ===== */
.hcc-ground {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 20%;
  background: linear-gradient(
    to bottom,
    #08141f 0%,
    #040c16 60%,
    #020810 100%
  );
  overflow: hidden;
}
/* ビルの光の路面反射 */
.hcc-reflect {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 65%;
  background: linear-gradient(
    to right,
    transparent 5%,
    rgba(210,130,30,.04) 28%,
    rgba(90,140,210,.06) 50%,
    rgba(210,130,30,.04) 72%,
    transparent 95%
  );
}
/* 白線 */
.hcc-marking {
  position: absolute;
  top: 40%;
  left: 0;
  width: 100%;
  height: 2px;
  background: repeating-linear-gradient(
    to right,
    transparent 0px 36px,
    rgba(255,255,255,.055) 36px 72px
  );
}
.hcc-ground::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 35%;
  background: linear-gradient(
    to right,
    transparent 10%,
    rgba(80,130,200,.04) 40%,
    rgba(80,130,200,.04) 60%,
    transparent 90%
  );
}

/* ===== HAZE（大気散乱） ===== */
.hcc-haze {
  position: absolute;
  bottom: 14%;
  left: 0;
  width: 100%;
  height: 22%;
  pointer-events: none;
  background: linear-gradient(
    to top,
    rgba(6,16,28,.60) 0%,
    rgba(6,16,28,.22) 50%,
    transparent 100%
  );
}

/* ===== FILM GRAIN ===== */
.hcc-grain {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .036;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23g)'/%3E%3C/svg%3E");
  background-size: 200px 200px;
  mix-blend-mode: overlay;
}

/* ===== LETTERBOX ===== */
.hcc-bar {
  position: absolute;
  left: 0;
  width: 100%;
  background: #000;
  z-index: 20;
}
.hcc-bar-top    { top: 0;    height: 10svh; }
.hcc-bar-bottom { bottom: 0; height: 10svh; }

/* ===== TEXT OVERLAY ===== */
.hcc-text-wrap {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 12svh 7vw 16svh;
  z-index: 10;
  pointer-events: none;
  will-change: opacity;
  opacity: 0;
  max-width: 680px;
}
.hcc-eyebrow {
  font-size: clamp(10px, 1.1vw, 13px);
  letter-spacing: .22em;
  color: #c9982c;
  text-transform: uppercase;
  margin: 0 0 14px;
  font-weight: 700;
}
.hcc-headline {
  font-size: clamp(22px, 3.8vw, 48px);
  font-weight: 900;
  color: #fff;
  line-height: 1.22;
  margin: 0 0 18px;
  text-shadow: 0 2px 24px rgba(0,0,0,.85);
}
.hcc-sub {
  font-size: clamp(12px, 1.3vw, 15px);
  color: rgba(255,255,255,.65);
  margin: 0 0 24px;
  line-height: 1.7;
}
.hcc-badges { display: flex; flex-wrap: wrap; gap: 8px; }
.hcc-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  padding: 5px 10px;
  border: 1px solid rgba(201,152,44,.45);
  border-radius: 4px;
  color: rgba(255,255,255,.8);
  letter-spacing: .04em;
}
.hcc-badge-val { color: #c9982c; font-weight: 700; }

/* ===== SP =====
   モバイルはスクロールアニメーションをOFFにし、静的ヒーローとして表示。
   LPコンテンツ（数字・メリット・フローなど）に最初から到達できる。
*/
@media (max-width: 640px) {
  /* スクロール領域を1画面分に限定 → 下のLPセクションが直後に現れる */
  .hcc-root { height: 100svh; }
  /* テキストをCSSで常時表示（JSのスクロール依存opacity=0を上書き） */
  .hcc-text-wrap {
    opacity: 1 !important;
    padding: 9svh 6vw 14svh;
    justify-content: flex-end;
  }
  .hcc-svg-far  { width: 360vw; }
  .hcc-svg-mid  { width: 420vw; }
  .hcc-svg-near { width: 300vw; }
  .hcc-bar-top, .hcc-bar-bottom { height: 8svh; }
  .hcc-headline { font-size: clamp(20px, 5.5vw, 30px); }
}
</style>

<script>
(function () {
  var root  = document.getElementById('hcc-root');
  var far   = document.getElementById('hcc-far');
  var mid   = document.getElementById('hcc-mid');
  var near  = document.getElementById('hcc-near');
  var light = document.getElementById('hcc-light');
  var text  = document.getElementById('hcc-text');
  if (!root || !far || !mid || !near || !light || !text) return;

  var W = window.innerWidth;
  var rafId = 0;
  var active = false;

  function clamp(v, lo, hi) { return v < lo ? lo : v > hi ? hi : v; }
  function norm(v, lo, hi)  { return clamp((v - lo) / (hi - lo), 0, 1); }
  function ease(t) { return t < .5 ? 2 * t * t : -1 + (4 - 2 * t) * t; }

  function update() {
    var rect  = root.getBoundingClientRect();
    var total = root.offsetHeight - window.innerHeight;
    var p     = total > 0 ? clamp(-rect.top, 0, total) / total : 0;

    far.style.transform  = 'translateX(' + (-p * W * 0.55) + 'px)';
    mid.style.transform  = 'translateX(' + (-p * W * 1.05) + 'px)';
    near.style.transform = 'translateX(' + (-p * W * 1.80) + 'px)';

    var lightOp = norm(p, 0.18, 0.42) - norm(p, 0.72, 0.92);
    light.style.opacity   = String(clamp(lightOp, 0, 1));
    light.style.transform = 'translateX(' + (W * 0.32 + p * W * 0.20) + 'px)';

    text.style.opacity = String(ease(norm(p, 0.58, 0.84)));
  }

  function tick() {
    update();
    if (active) rafId = requestAnimationFrame(tick);
  }

  var io = new IntersectionObserver(function(entries) {
    active = entries[0].isIntersecting;
    if (active) { rafId = requestAnimationFrame(tick); }
    else         { cancelAnimationFrame(rafId); }
  }, { threshold: 0 });
  io.observe(root);

  update();
})();
</script>
