/* ===== SP ===== */
@media (max-width: 640px) {
  .hcc-root { height: 260vh; }
  .hcc-svg-far  { width: 360vw; }
  .hcc-svg-mid  { width: 420vw; }
  .hcc-svg-near { width: 300vw; }
  .hcc-walker { width: 64px; height: 128px; }
  .hcc-bar-top, .hcc-bar-bottom { height: 8svh; }
  .hcc-text-wrap { padding: 9svh 6vw 14svh; justify-content: flex-end; }
  .hcc-headline { font-size: clamp(20px, 5.5vw, 30px); }
}
</style>

<script>
(function () {
  var root   = document.getElementById('hcc-root');
  var far    = document.getElementById('hcc-far');
  var mid    = document.getElementById('hcc-mid');
  var near   = document.getElementById('hcc-near');
  var person = document.getElementById('hcc-person');
  var light  = document.getElementById('hcc-light');
  var text   = document.getElementById('hcc-text');
  if (!root || !far || !mid || !near || !person || !light || !text) return;

  var W = window.innerWidth;
  var rafId = 0;
  var active = false;

  function clamp(v, lo, hi) { return v < lo ? lo : v > hi ? hi : v; }
  function norm(v, lo, hi)  { return clamp((v - lo) / (hi - lo), 0, 1); }
  function ease(t) { return t < .5 ? 2 * t * t : -1 + (4 - 2 * t) * t; }

  function update() {
    var rect  = root.getBoundingClientRect();
    var total = root.offsetHeight - window.innerHeight;
    var p     = total > 0 ? clamp(-rect.top, 0, total) / total : 0;

    far.style.transform  = 'translateX(' + (-p * W * 0.55) + 'px)';
    mid.style.transform  = 'translateX(' + (-p * W * 1.05) + 'px)';
    near.style.transform = 'translateX(' + (-p * W * 1.80) + 'px)';

    var pPerson = ease(norm(p, 0, 0.82));
    var personX = W * (0.08 + pPerson * 0.36);
    var scale   = 1 + pPerson * 0.14;
    person.style.transform       = 'translateX(' + personX + 'px) scale(' + scale + ')';
    person.style.transformOrigin = '0 100%';

    var lightOp = norm(p, 0.30, 0.48) - norm(p, 0.74, 0.92);
    light.style.opacity   = String(clamp(lightOp, 0, 1));
    light.style.transform = 'translateX(' + (W * 0.28 + p * W * 0.18) + 'px)';

    text.style.opacity = String(ease(norm(p, 0.62, 0.88)));
  }

  function tick() {
    update();
    if (active) rafId = requestAnimationFrame(tick);
  }

  var io = new IntersectionObserver(function(entries) {
    active = entries[0].isIntersecting;
    if (active) { rafId = requestAnimationFrame(tick); }
    else         { cancelAnimationFrame(rafId); }
  }, { threshold: 0 });
  io.observe(root);

  update();
})();
</script>
