  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 12svh 7vw 16svh;
  z-index: 10;
  pointer-events: none;
  will-change: opacity;
  opacity: 0;
  max-width: 680px;
}
.hcc-eyebrow {
  font-size: clamp(10px, 1.1vw, 13px);
  letter-spacing: .22em;
