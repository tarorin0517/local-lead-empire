---
import type { SiteMeta } from '../lib/sites';

interface Props {
  site: SiteMeta;
}

const { site } = Astro.props;
const items = site.reasons ?? [];
---

{items.length > 0 && (
  <section class="bg-bg-section px-4 py-12 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center text-2xl font-bold text-primary-900 sm:text-3xl">
        選ばれる5つの理由
      </h2>

      <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((item, i) => (
          <li class="rounded-xl border border-primary-100 bg-white p-5 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-trust text-sm font-bold text-white">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="text-base font-bold text-primary-900 sm:text-lg">{item.title}</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">
              {item.description}
            </p>
          </li>
        ))}
      </ol>

      {site.achievementsNote && (
        <p class="mt-4 text-center text-[11px] text-ink-muted">
          {site.achievementsNote}
        </p>
      )}
    </div>
  </section>
)}
