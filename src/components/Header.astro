---
import type { SiteMeta } from '../lib/sites';
import { telHref } from '../lib/sites';

interface Props {
  site: SiteMeta;
}

const { site } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-primary-100 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-2 px-4 py-3 sm:gap-4">
    <a
      href={site.baseUrlPath}
      class="flex min-w-0 flex-col leading-tight"
    >
      <span class="text-xs text-primary-700 sm:text-sm">{site.city}・{site.niche}</span>
      <span class="truncate text-base font-bold text-primary-900 sm:text-lg">
        {site.siteShortName ?? site.siteName}
      </span>
    </a>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <a
        href={telHref(site.phone)}
        class="hidden flex-col items-end leading-tight sm:flex"
        aria-label={`電話で相談する ${site.phone}`}
        onclick="if(typeof gtag!=='undefined'){gtag('event','generate_lead',{method:'phone',event_label:'header_desktop'});gtag('event','phone_click',{event_category:'cta',event_label:'header_desktop',event_callback:function(){}})}"
      >
        <span class="text-[10px] text-ink-muted">{site.phoneHoursLabel ?? '受付時間内'}</span>
        <span class="text-lg font-bold text-primary-700">{site.phone}</span>
      </a>
      <a
        href={telHref(site.phone)}
        class="flex flex-col items-center justify-center rounded-md bg-primary-700 px-3 py-2 text-white shadow-sm hover:bg-primary-900 sm:hidden"
        aria-label={`電話で相談する ${site.phone}`}
        onclick="if(typeof gtag!=='undefined'){gtag('event','generate_lead',{method:'phone',event_label:'header_mobile'});gtag('event','phone_click',{event_category:'cta',event_label:'header_mobile'})}"
      >
        <span class="text-[9px] leading-none opacity-80">📞 タップで発信</span>
        <span class="text-xs font-bold leading-tight">{site.phone}</span>
      </a>
      <a
        href="#contact"
        class="inline-flex items-center justify-center rounded-md bg-accent-500 px-3 py-2 text-sm font-bold text-white shadow-sm hover:bg-accent-600 sm:px-4"
      >
        お問い合わせ
      </a>
    </div>
  </div>
</header>
