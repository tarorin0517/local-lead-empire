---
import type { SiteMeta } from '../lib/sites';

interface Props {
  site: SiteMeta;
}

const { site } = Astro.props;
const rows = site.priceTable ?? [];
const note = site.priceNote;
---

{rows.length > 0 && (
  <section id="price" class="px-4 py-12 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center text-2xl font-bold text-primary-900 sm:text-3xl">
        料金表
      </h2>
      <p class="mt-2 text-center text-sm text-ink-muted">
        税込・出張費込みの明朗会計です。
      </p>

      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[480px] border-collapse text-sm">
          <thead>
            <tr class="bg-trust text-white">
              <th class="px-3 py-3 text-left font-semibold">プラン</th>
              <th class="px-3 py-3 text-right font-semibold">1台目（税込）</th>
              <th class="px-3 py-3 text-right font-semibold">2台目以降（税込）</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-bg-soft'}>
                <td class="border-b border-slate-200 px-3 py-3 font-semibold text-ink">{row.plan}</td>
                <td class="border-b border-slate-200 px-3 py-3 text-right font-bold text-primary-700">{row.first}</td>
                <td class="border-b border-slate-200 px-3 py-3 text-right text-ink">{row.additional}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {note && (
        <p class="mt-3 text-xs text-ink-muted">
          ※ {note}
        </p>
      )}
    </div>
  </section>
)}
