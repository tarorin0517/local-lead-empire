---
import { Image } from 'astro:assets';
import type { SiteMeta } from '../lib/sites';
import flow1 from '../assets/images/_extra-reception.jpg';
import flow2 from '../assets/images/work-protection.jpg';
import flow3 from '../assets/images/_extra-work-2.jpg';
import flow4 from '../assets/images/work-cleaning.jpg';
import flow5 from '../assets/images/handover.jpg';

interface Props {
  site: SiteMeta;
}

const { site } = Astro.props;
const steps = site.flow ?? [];
const stepImages = [flow1, flow2, flow3, flow4, flow5];
---

{steps.length > 0 && (
  <section class="px-4 py-12 sm:py-16">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-center text-2xl font-bold text-primary-900 sm:text-3xl">
        ご依頼から完了までの流れ
      </h2>

      <ol class="mt-8 space-y-4">
        {steps.map((step, i) => (
          <li class="flex gap-4 rounded-lg border border-primary-100 bg-white p-5 shadow-sm">
            <div class="flex shrink-0 flex-col items-center">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-trust text-sm font-bold text-white">
                STEP{i + 1}
              </span>
              {i < steps.length - 1 && (
                <span aria-hidden="true" class="mt-1 h-full w-0.5 bg-primary-100"></span>
              )}
            </div>
            <div class="flex-1 pb-1">
              <h3 class="text-base font-bold text-primary-900 sm:text-lg">{step.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-ink-muted">{step.description}</p>
            </div>
            {stepImages[i] && (
              <Image
                src={stepImages[i]}
                alt={`${site.city}のエアコン分解洗浄 STEP${i + 1}：${step.title}`}
                loading="lazy"
                decoding="async"
                class="hidden h-20 w-20 shrink-0 rounded-md object-cover sm:block"
              />
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>
)}
