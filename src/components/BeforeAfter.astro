---
import { Image } from 'astro:assets';
import type { SiteMeta } from '../lib/sites';
import before1 from '../assets/images/before-1.jpg';
import after1 from '../assets/images/_extra-filter-green.jpg';
import before2 from '../assets/images/before-2.jpg';
import after2 from '../assets/images/work-cleaning.jpg';
import before3 from '../assets/images/before-3.jpg';
import after3 from '../assets/images/handover.jpg';

interface Props {
  site: SiteMeta;
}

const { site } = Astro.props;
const items = site.beforeAfter ?? [];

const imagePairs = [
  { before: before1, after: after1 },
  { before: before2, after: after2 },
  { before: before3, after: after3 },
];
---

{items.length > 0 && (
  <section class="px-4 py-12 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center text-2xl font-bold text-primary-900 sm:text-3xl">
        施工事例（Before / After）
      </h2>
      <p class="mt-2 text-center text-sm text-ink-muted">
        宮崎市内で実施した分解洗浄の施工事例です。
      </p>

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((item, i) => {
          const pair = imagePairs[i];
          return (
            <figure class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm">
              <div class="grid grid-cols-2 gap-2">
                {pair && (
                  <Image
                    src={pair.before}
                    alt={item.beforeAlt}
                    loading="lazy"
                    decoding="async"
                    class="block aspect-[4/3] h-auto w-full rounded object-cover"
                  />
                )}
                {pair && (
                  <Image
                    src={pair.after}
                    alt={item.afterAlt}
                    loading="lazy"
                    decoding="async"
                    class="block aspect-[4/3] h-auto w-full rounded object-cover"
                  />
                )}
              </div>
              <figcaption class="mt-3 text-center text-sm font-semibold text-ink">
                {item.caption}
              </figcaption>
            </figure>
          );
        })}
      </div>
    </div>
  </section>
)}
