---
import type { SiteMeta } from '../lib/sites';
import { buildCanonical } from '../lib/sites';
import { SITE_URL } from '../lib/site-url';

export type PageKind = 'top' | 'article' | 'service' | 'area' | 'symptom';

export interface FaqItem {
  question: string;
  answer: string;
}

export interface BreadcrumbItem {
  name: string;
  urlPath: string;
}

interface Props {
  site: SiteMeta;
  kind: PageKind;
  pageTitle: string;
  pageDescription: string;
  urlPath: string;
  publishedTime?: string;
  modifiedTime?: string;
  author: string;
  faqs?: FaqItem[];
  breadcrumbs?: BreadcrumbItem[];
}

const {
  site,
  kind,
  pageTitle,
  pageDescription,
  urlPath,
  publishedTime,
  modifiedTime,
  author,
  faqs,
  breadcrumbs,
} = Astro.props;

const canonical = buildCanonical(SITE_URL, urlPath);
const businessUrl = buildCanonical(SITE_URL, site.baseUrlPath);
const businessId = `${businessUrl}#localbusiness`;
const serviceId = `${businessUrl}#service`;

const businessImage = site.ogImage
  ? buildCanonical(SITE_URL, site.ogImage)
  : undefined;

/**
 * HomeAndConstructionBusiness（schema.org の LocalBusiness 派生型）。
 * 住宅修繕・清掃・設備工事系の地域業者に最適。
 */
const business = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': businessId,
  name: site.siteName,
  description: site.tagline,
  url: businessUrl,
  telephone: site.phone,
  ...(businessImage ? { image: businessImage } : {}),
  ...(site.priceRangeStructured
    ? { priceRange: site.priceRangeStructured }
    : site.priceRangeLabel
    ? { priceRange: site.priceRangeLabel }
    : {}),
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'JP',
    addressRegion: site.prefecture ?? site.city,
    addressLocality: site.city,
    streetAddress: site.owner.address,
  },
  ...(site.geo
    ? {
        geo: {
          '@type': 'GeoCoordinates',
          latitude: site.geo.latitude,
          longitude: site.geo.longitude,
        },
      }
    : {}),
  areaServed: (site.areaServed ?? [site.city]).map((name) => ({
    '@type': 'City',
    name,
  })),
  ...(site.openingHours && site.openingHours.length > 0
    ? { openingHours: site.openingHours }
    : {}),
  ...(site.sameAs && site.sameAs.length > 0 ? { sameAs: site.sameAs } : {}),
};

const offers =
  site.priceTable && site.priceTable.length > 0
    ? site.priceTable.map((row) => ({
        '@type': 'Offer',
        name: row.plan,
        price: row.first.replace(/[^\d]/g, ''),
        priceCurrency: 'JPY',
      }))
    : undefined;

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': serviceId,
  serviceType: site.niche,
  provider: { '@id': businessId },
  areaServed: (site.areaServed ?? [site.city]).map((name) => ({
    '@type': 'City',
    name,
  })),
  name: `${site.city}の${site.niche}`,
  description: site.tagline,
  ...(offers ? { offers } : {}),
};

const article =
  kind !== 'top'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: pageTitle,
        description: pageDescription,
        mainEntityOfPage: canonical,
        inLanguage: 'ja',
        author: { '@type': 'Person', name: author },
        publisher: {
          '@type': 'Organization',
          name: site.siteName,
          logo: site.logoPath
            ? {
                '@type': 'ImageObject',
                url: buildCanonical(SITE_URL, site.logoPath),
              }
            : undefined,
        },
        ...(publishedTime ? { datePublished: publishedTime } : {}),
        ...(modifiedTime ? { dateModified: modifiedTime } : {}),
      }
    : null;

const faqPage =
  faqs && faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: f.answer,
          },
        })),
      }
    : null;

const breadcrumbList =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: buildCanonical(SITE_URL, b.urlPath),
        })),
      }
    : null;

const blocks = [
  business,
  service,
  article,
  faqPage,
  breadcrumbList,
].filter((b): b is NonNullable<typeof b> => b !== null);
---

{blocks.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}
