---
/**
 * HeroCivilRealestate — 公務員不動産投資LP専用 スクロール連動3Dマンション分解 Hero
 * スクロールに連動してマンションの各フロアが分離し、投資の仕組みを体験させる
 */
import type { SiteMeta } from '../lib/sites';
import { telHref } from '../lib/sites';

interface Props {
  site: SiteMeta;
}

const { site } = Astro.props;
const phone = site.phone;
const cta = site.ctaCopy;
const trustBadges = site.trustBadges ?? [];
---

<section class="hcr" id="hcr-root">
  <div class="hcr-sticky">

    <!-- ===== Left: copy ===== -->
    <div class="hcr-copy">
      <span class="hcr-tag">
        <span class="hcr-tag-dot"></span>
        公務員 × 不動産投資 / 副業届出不要の資産形成
      </span>
      <h1 class="hcr-h1">
        安定の信用力が、<br/>
        <span class="hcr-h1-em">最大の武器</span>になる。
      </h1>
      <p class="hcr-lead">
        公務員の最大の強みは「銀行への信用力」。スクロールして、
        9室以下で始める<strong>許可不要の不動産投資</strong>の仕組みを体験してください。
      </p>
      <div class="hcr-ctas">
        <a href={telHref(phone)} class="hcr-btn-phone"
          aria-label={`電話で無料相談 ${phone}`}
          onclick={`if(typeof gtag!=='undefined'){gtag('event','generate_lead',{method:'phone',event_label:'hero'});}`}>
          <span class="hcr-btn-label">{cta?.phonePrimary ?? '無料で電話相談'}</span>
          <span class="hcr-btn-num">{phone}</span>
          <span class="hcr-btn-hours">{cta?.phoneSecondary ?? site.phoneHoursLabel}</span>
        </a>
        <a href="#contact" class="hcr-btn-form">
          {cta?.formPrimary ?? '無料相談を申込む'}
        </a>
      </div>
      {trustBadges.length > 0 && (
        <ul class="hcr-badges">
          {trustBadges.map((b) => (
            <li class="hcr-badge">
              <span class="hcr-badge-k">{b.label}</span>
              <span class="hcr-badge-v">{b.value}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- ===== Right: 3-D building stage ===== -->
    <div class="hcr-stage-wrap">
      <div class="hcr-stage" id="hcr-stage">

        <!-- perspective root (JS rotates this) -->
        <div class="hcr-scene" id="hcr-scene">
          <div class="hcr-shadow"></div>

          <!-- RF: 公務員の信用力 (gold) -->
          <div class="hcr-floor" id="hcr-rf">
            <div class="hcr-face hcr-front hcr-front-rf">
              <div class="hcr-roof-detail"></div>
              <span class="hcr-fn">RF</span>
              <span class="hcr-fname">公務員の信用力</span>
            </div>
            <div class="hcr-face hcr-fback hcr-back-rf"></div>
            <div class="hcr-face hcr-flwall hcr-lw-rf"></div>
            <div class="hcr-face hcr-frwall hcr-rw-rf"></div>
            <div class="hcr-face hcr-ftop hcr-top-rf"></div>
          </div>

          <!-- 3F: 資産形成 -->
          <div class="hcr-floor" id="hcr-f3">
            <div class="hcr-face hcr-front hcr-front-f3">
              <div class="hcr-windows"></div>
              <span class="hcr-fn">3F</span>
              <span class="hcr-fname">資産形成・純資産増加</span>
            </div>
            <div class="hcr-face hcr-fback"></div>
            <div class="hcr-face hcr-flwall"></div>
            <div class="hcr-face hcr-frwall"></div>
            <div class="hcr-face hcr-ftop hcr-top-f3"></div>
          </div>

          <!-- 2F: 節税効果 -->
          <div class="hcr-floor" id="hcr-f2">
            <div class="hcr-face hcr-front hcr-front-f2">
              <div class="hcr-windows"></div>
              <span class="hcr-fn">2F</span>
              <span class="hcr-fname">節税効果・減価償却</span>
            </div>
            <div class="hcr-face hcr-fback"></div>
            <div class="hcr-face hcr-flwall"></div>
            <div class="hcr-face hcr-frwall"></div>
            <div class="hcr-face hcr-ftop hcr-top-f2"></div>
          </div>

          <!-- 1F: 家賃収入 -->
          <div class="hcr-floor" id="hcr-f1">
            <div class="hcr-face hcr-front hcr-front-f1">
              <div class="hcr-windows"></div>
              <span class="hcr-fn">1F</span>
              <span class="hcr-fname">家賃収入・安定CF</span>
            </div>
            <div class="hcr-face hcr-fback"></div>
            <div class="hcr-face hcr-flwall"></div>
            <div class="hcr-face hcr-frwall"></div>
            <div class="hcr-face hcr-ftop hcr-top-f1"></div>
          </div>

          <!-- BF: 銀行融資 (foundation) -->
          <div class="hcr-floor" id="hcr-bf">
            <div class="hcr-face hcr-front hcr-front-bf">
              <div class="hcr-bf-cols">
                <div class="hcr-col"></div>
                <div class="hcr-col"></div>
                <div class="hcr-col"></div>
                <div class="hcr-col"></div>
              </div>
              <span class="hcr-fn">BF</span>
              <span class="hcr-fname">銀行融資・レバレッジ</span>
            </div>
            <div class="hcr-face hcr-fback hcr-back-bf"></div>
            <div class="hcr-face hcr-flwall hcr-lw-bf"></div>
            <div class="hcr-face hcr-frwall hcr-rw-bf"></div>
          </div>
        </div><!-- /hcr-scene -->

        <!-- progress steps -->
        <div class="hcr-progress" id="hcr-progress" aria-hidden="true">
          <div class="hcr-step hcr-step-on" data-step="0">
            <span class="hcr-step-pip"></span><span>ASSEMBLED</span>
          </div>
          <div class="hcr-step" data-step="1">
            <span class="hcr-step-pip"></span><span>LOAN POWER</span>
          </div>
          <div class="hcr-step" data-step="2">
            <span class="hcr-step-pip"></span><span>RENTAL INCOME</span>
          </div>
          <div class="hcr-step" data-step="3">
            <span class="hcr-step-pip"></span><span>TAX BENEFIT</span>
          </div>
          <div class="hcr-step" data-step="4">
            <span class="hcr-step-pip"></span><span>ASSET GROWTH</span>
          </div>
          <div class="hcr-step" data-step="5">
            <span class="hcr-step-pip"></span><span>CIVIL SERVANT</span>
          </div>
        </div>
      </div><!-- /hcr-stage -->

      <div class="hcr-scroll-hint" aria-hidden="true">
        <span>SCROLL TO REVEAL</span>
        <span class="hcr-scroll-bar"></span>
      </div>
    </div><!-- /hcr-stage-wrap -->

  </div><!-- /hcr-sticky -->
</section>

<style>
/* ============================================================
   DESIGN TOKENS
   ============================================================ */
.hcr {
  --hcr-navy-1: #1e3a6e;
  --hcr-navy-2: #0f2351;
  --hcr-navy-3: #d4dce8;
  --hcr-gold:   #c9982c;
  --hcr-gold-2: #8a6518;
  --hcr-ink:    #0c1a2e;
  --hcr-ink-2:  #3a5070;
  --hcr-ink-3:  #7a92b0;
  --hcr-line:   #d0d8e8;
}

/* ============================================================
   SECTION / SCROLL DRIVER (300vh)
   ============================================================ */
.hcr {
  position: relative;
  height: 300vh;
  background:
    radial-gradient(1200px 600px at 80% -10%, #e8edf8, transparent 60%),
    radial-gradient(900px 500px at 5% 30%, #eef0fc, transparent 65%),
    linear-gradient(180deg, #f5f7fc 0%, #edf0fa 100%);
}

.hcr-sticky {
  position: sticky;
  top: 0;
  height: 100vh;
  width: 100%;
  overflow: clip;
  display: grid;
  grid-template-columns: 1fr 1.2fr;
}

/* ============================================================
   COPY SIDE
   ============================================================ */
.hcr-copy {
  position: relative;
  z-index: 5;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 0 0 80px;
  max-width: 620px;
}

.hcr-tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #fff;
  border: 1px solid var(--hcr-navy-3);
  color: var(--hcr-navy-2);
  padding: 8px 14px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  width: max-content;
  box-shadow: 0 4px 20px rgba(15,35,81,.06);
}
.hcr-tag-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--hcr-gold);
  box-shadow: 0 0 0 4px rgba(201,152,44,.25);
  flex-shrink: 0;
}

.hcr-h1 {
  font-weight: 800;
  font-size: clamp(30px, 4vw, 54px);
  line-height: 1.22;
  letter-spacing: -0.01em;
  margin: 20px 0 16px;
  color: var(--hcr-ink);
}
.hcr-h1-em {
  background: linear-gradient(120deg, var(--hcr-gold) 30%, var(--hcr-gold-2));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hcr-lead {
  color: var(--hcr-ink-2);
  font-size: 15px;
  line-height: 1.9;
  margin-bottom: 24px;
  max-width: 460px;
}
.hcr-lead strong { color: var(--hcr-navy-1); }

/* CTAs */
.hcr-ctas { display: flex; gap: 12px; flex-wrap: wrap; }

.hcr-btn-phone {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10px 18px;
  border-radius: 12px;
  background: var(--hcr-gold);
  color: #fff;
  text-decoration: none;
  box-shadow: 0 8px 18px -4px rgba(201,152,44,.5);
  transition: transform .15s, box-shadow .15s;
}
.hcr-btn-phone:hover { transform: translateY(-1px); box-shadow: 0 12px 22px -4px rgba(201,152,44,.55); }
.hcr-btn-label { font-size: 11px; opacity: .9; }
.hcr-btn-num   { font-size: 18px; font-weight: 700; letter-spacing: .02em; }
.hcr-btn-hours { font-size: 10px; opacity: .85; }

.hcr-btn-form {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 20px;
  border-radius: 12px;
  background: var(--hcr-navy-1);
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  box-shadow: 0 8px 18px -4px rgba(30,58,110,.4);
  transition: transform .15s, background .15s;
}
.hcr-btn-form:hover { transform: translateY(-1px); background: var(--hcr-navy-2); }

/* trust badges */
.hcr-badges {
  list-style: none;
  padding: 0;
  margin: 24px 0 0;
  display: flex;
  gap: 20px;
  border-top: 1px solid var(--hcr-line);
  padding-top: 18px;
}
.hcr-badge-k { font-size: 10px; color: var(--hcr-ink-2); letter-spacing: .08em; text-transform: uppercase; display: block; }
.hcr-badge-v { font-weight: 700; font-size: 20px; color: var(--hcr-navy-1); }

/* ============================================================
   STAGE SIDE
   ============================================================ */
.hcr-stage-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hcr-stage {
  position: relative;
  width: 100%;
  height: 100%;
  perspective: 1600px;
  perspective-origin: 55% 45%;
}

.hcr-scene {
  position: absolute;
  inset: 0;
  -webkit-transform-style: preserve-3d;
  transform-style: preserve-3d;
  transform: translateZ(-80px) rotateX(10deg) rotateY(-22deg);
  transition: transform 0.05s linear;
}

/* ============================================================
   3-D FLOOR PARTS  (Desktop: W480 × H56 × D100)
   Each .hcr-floor is positioned via JS transforms.
   ============================================================ */
.hcr-floor {
  position: absolute;
  left: 50%; top: 50%;
  width: 480px; height: 56px;
  -webkit-transform-style: preserve-3d;
  transform-style: preserve-3d;
  transition: transform 0.06s linear;
  will-change: transform;
}

.hcr-face {
  position: absolute;
  left: 0; top: 0;
  -webkit-transform-style: preserve-3d;
  transform-style: preserve-3d;
  border: 1px solid rgba(255,255,255,.15);
}

/* Front (z = +50) */
.hcr-front {
  width: 480px; height: 56px;
  transform: translateZ(50px);
  overflow: hidden;
}

/* Back (z = -50) */
.hcr-fback {
  width: 480px; height: 56px;
  transform: translateZ(-50px);
  background: rgba(10,20,50,.6);
}

/* Left wall */
.hcr-flwall {
  width: 100px; height: 56px;
  transform: rotateY(-90deg) translateZ(-240px) translateX(-100px);
  background: rgba(10,20,50,.55);
}

/* Right wall */
.hcr-frwall {
  width: 100px; height: 56px;
  transform: rotateY(90deg) translateZ(240px);
  background: rgba(10,20,50,.55);
}

/* Top slab */
.hcr-ftop {
  width: 480px; height: 100px;
  transform: rotateX(90deg) translateZ(-28px);
}

/* ---- Floor front face colors ---- */
.hcr-front-rf {
  background: linear-gradient(135deg, #c9982c 0%, #a07018 100%);
  border-color: rgba(255,255,255,.3);
}
.hcr-front-f3 {
  background: linear-gradient(135deg, #243a60 0%, #152c4e 100%);
  border-color: rgba(255,255,255,.12);
}
.hcr-front-f2 {
  background: linear-gradient(135deg, #1e4878 0%, #0f3060 100%);
  border-color: rgba(255,255,255,.12);
}
.hcr-front-f1 {
  background: linear-gradient(135deg, #2a5a90 0%, #1a3e70 100%);
  border-color: rgba(255,255,255,.12);
}
.hcr-front-bf {
  background: linear-gradient(135deg, #4a5568 0%, #2d3748 100%);
  border-color: rgba(255,255,255,.1);
}

/* ---- Top slab colors ---- */
.hcr-top-rf { background: linear-gradient(90deg, #8a6518, #c9982c); }
.hcr-top-f3 { background: linear-gradient(90deg, #0c1e3a, #243a60); }
.hcr-top-f2 { background: linear-gradient(90deg, #0a1830, #1e4878); }
.hcr-top-f1 { background: linear-gradient(90deg, #0e2040, #2a5a90); }

/* Back/side overrides for BF and RF */
.hcr-back-rf { background: rgba(100,70,10,.7); }
.hcr-lw-rf, .hcr-rw-rf { background: rgba(100,70,10,.6); }
.hcr-back-bf { background: rgba(30,35,50,.7); }
.hcr-lw-bf, .hcr-rw-bf { background: rgba(30,35,50,.6); }

/* ---- Window pattern (1F,2F,3F) ---- */
.hcr-windows {
  position: absolute;
  inset: 8px 20px 8px 20px;
  background:
    repeating-linear-gradient(
      90deg,
      rgba(255,255,255,.18) 0 18px,
      transparent 18px 26px
    ),
    repeating-linear-gradient(
      180deg,
      rgba(255,255,255,.08) 0 1px,
      transparent 1px 8px
    );
  border-radius: 2px;
}

/* ---- RF roof detail ---- */
.hcr-roof-detail {
  position: absolute;
  bottom: 0; left: 20px; right: 20px;
  height: 8px;
  background: rgba(255,255,255,.25);
  border-radius: 2px 2px 0 0;
}

/* ---- BF columns ---- */
.hcr-bf-cols {
  position: absolute;
  inset: 8px 20px;
  display: flex;
  gap: 0;
  justify-content: space-around;
  align-items: stretch;
}
.hcr-col {
  width: 10px;
  background: rgba(255,255,255,.2);
  border-radius: 3px 3px 0 0;
}

/* ---- Floor number + name labels on front face ---- */
.hcr-fn {
  position: absolute;
  left: 10px;
  bottom: 6px;
  font-size: 11px;
  font-weight: 800;
  color: rgba(255,255,255,.9);
  letter-spacing: .1em;
  font-family: "Manrope", system-ui, monospace;
}
.hcr-fname {
  position: absolute;
  right: 12px;
  bottom: 7px;
  font-size: 10px;
  font-weight: 600;
  color: rgba(255,255,255,.75);
  letter-spacing: .05em;
  white-space: nowrap;
}

/* Shadow floor below building */
.hcr-shadow {
  position: absolute;
  left: 50%; top: 70%;
  width: 600px; height: 60px;
  transform: translateX(-50%) rotateX(90deg);
  background: radial-gradient(ellipse at center, rgba(30,58,110,.22), transparent 60%);
  filter: blur(10px);
  pointer-events: none;
}

/* ============================================================
   PROGRESS INDICATOR
   ============================================================ */
.hcr-progress {
  position: absolute;
  right: 40px; top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 10px;
  z-index: 5;
}
.hcr-step {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--hcr-ink-3);
  font-size: 11px;
  letter-spacing: .08em;
  font-family: "Manrope", system-ui, sans-serif;
  transition: color .3s;
}
.hcr-step-pip {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: #c8d4e0;
  transition: background .3s, transform .3s;
  flex-shrink: 0;
}
.hcr-step-on { color: var(--hcr-navy-1); font-weight: 700; }
.hcr-step-on .hcr-step-pip {
  background: var(--hcr-gold);
  transform: scale(1.6);
  box-shadow: 0 0 0 4px rgba(201,152,44,.22);
}

/* ============================================================
   SCROLL HINT
   ============================================================ */
.hcr-scroll-hint {
  position: absolute;
  bottom: 26px; left: 40px;
  z-index: 6;
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 11px;
  color: var(--hcr-ink-2);
  letter-spacing: .12em;
}
.hcr-scroll-bar {
  width: 60px; height: 1px;
  background: var(--hcr-ink-3);
  position: relative;
  overflow: hidden;
}
.hcr-scroll-bar::after {
  content: "";
  position: absolute; inset: 0;
  background: var(--hcr-gold);
  animation: hcr-bar-anim 1.6s ease-in-out infinite;
}
@keyframes hcr-bar-anim {
  0%   { transform: translateX(-100%); }
  60%, 100% { transform: translateX(100%); }
}

/* ============================================================
   RESPONSIVE — タブレット (641px–1024px)
   ============================================================ */
@media (min-width: 641px) and (max-width: 1024px) {
  .hcr-sticky {
    display: flex;
    flex-direction: column;
    grid-template-columns: unset;
  }
  .hcr-copy {
    flex: 0 0 auto;
    padding: 84px 28px 16px;
    max-width: 100%;
    justify-content: flex-start;
  }
  .hcr-stage-wrap { flex: 1 1 0; min-height: 0; }
  .hcr-stage { transform: scale(0.62); transform-origin: 55% 45%; }
  .hcr-progress { display: none; }
  .hcr-scroll-hint { left: 24px; bottom: 16px; }
  .hcr-h1 { font-size: clamp(24px, 5vw, 38px); margin: 14px 0 12px; }
  .hcr-lead { font-size: 14px; margin-bottom: 18px; max-width: 100%; }
  .hcr-badges { flex-wrap: wrap; gap: 10px 18px; margin-top: 16px; padding-top: 14px; }
  .hcr-badge-v { font-size: 17px; }
}

/* ============================================================
   RESPONSIVE — スマホ (≤640px)
   ============================================================ */
@media (max-width: 640px) {
  .hcr { height: 130vh; height: 130svh; }

  .hcr-sticky {
    top: 66px;
    height: calc(100vh - 66px);
    height: calc(100svh - 66px);
    overflow: visible;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr;
  }

  .hcr-copy {
    grid-row: 1;
    padding: 16px 16px 8px;
    max-width: 100%;
    z-index: 5;
    position: relative;
  }

  .hcr-stage-wrap {
    grid-row: 2;
    position: relative;
    align-self: stretch;
    overflow: clip;
  }

  .hcr-stage {
    position: absolute;
    inset: 0;
    transform: none;
    perspective: 800px;
    perspective-origin: 50% 45%;
  }
  .hcr-scene {
    transform: translateZ(-40px) rotateX(8deg) rotateY(-16deg);
  }

  /* SP floor dimensions: W240 × H28 × D50 */
  .hcr-floor   { width: 240px; height: 28px; }
  .hcr-front   { width: 240px; height: 28px; transform: translateZ(25px); }
  .hcr-fback   { width: 240px; height: 28px; transform: translateZ(-25px); }
  .hcr-flwall  { width: 50px;  height: 28px; transform: rotateY(-90deg) translateZ(-120px) translateX(-50px); }
  .hcr-frwall  { width: 50px;  height: 28px; transform: rotateY(90deg) translateZ(120px); }
  .hcr-ftop    { width: 240px; height: 50px;  transform: rotateX(90deg) translateZ(-14px); }

  .hcr-fname { font-size: 8px; right: 8px; bottom: 4px; }
  .hcr-fn    { font-size: 9px; left: 6px; bottom: 4px; }
  .hcr-windows { inset: 4px 10px; }
  .hcr-bf-cols { inset: 4px 10px; }
  .hcr-col { width: 6px; }
  .hcr-roof-detail { height: 4px; left: 10px; right: 10px; }
  .hcr-shadow { width: 300px; height: 30px; top: 68%; }

  .hcr-progress { display: none; }
  .hcr-scroll-hint { display: none; }

  .hcr-tag  { font-size: 10px; padding: 5px 10px; }
  .hcr-h1   { font-size: clamp(20px, 5.5vw, 26px); line-height: 1.2; margin: 8px 0 6px; }
  .hcr-lead { font-size: 12px; line-height: 1.7; margin-bottom: 8px; }
  .hcr-badges { display: none; }

  .hcr-ctas { gap: 8px; }
  .hcr-btn-phone { flex: 1; flex-direction: column; padding: 8px; }
  .hcr-btn-num   { font-size: 14px; }
  .hcr-btn-form  { flex: 1; font-size: 12px; padding: 8px; }
}

/* prefers-reduced-motion */
@media (prefers-reduced-motion: reduce) {
  .hcr-scene  { transition: none; }
  .hcr-floor  { transition: none; }
  .hcr        { height: 100vh !important; }
  .hcr-sticky { top: 0 !important; height: 100vh !important; }
  .hcr-scroll-bar::after { animation: none; }
  .hcr-scroll-hint { display: none; }
}
@media (prefers-reduced-motion: reduce) and (max-width: 640px) {
  .hcr        { height: calc(100vh - 66px) !important; height: calc(100svh - 66px) !important; }
  .hcr-sticky { top: 66px !important; height: calc(100vh - 66px) !important; height: calc(100svh - 66px) !important; }
}
</style>

<script>
(function () {
  // ---- Desktop parts (W480 × H56 × D100) ----
  // base = assembled position, ex = exploded position
  // Y assembled: BF=84, 1F=28, 2F=-28, 3F=-84, RF=-140 (building centered at 0)
  // Y exploded: floors float upward, BF drops slightly
  const PARTS_D = [
    { id: 'bf', base: 't(-240,84,-50)',   ex: 't(-240,120,-50)',  start: 0.05, end: 0.70 },
    { id: 'f1', base: 't(-240,28,-50)',   ex: 't(-240,-100,-50)', start: 0.12, end: 0.75 },
    { id: 'f2', base: 't(-240,-28,-50)',  ex: 't(-240,-260,-50)', start: 0.22, end: 0.80 },
    { id: 'f3', base: 't(-240,-84,-50)',  ex: 't(-240,-400,-50)', start: 0.32, end: 0.85 },
    { id: 'rf', base: 't(-240,-140,-50)', ex: 't(-240,-540,-50)', start: 0.42, end: 0.90 },
  ];

  // ---- SP parts (W240 × H28 × D50) ----
  const PARTS_SP = [
    { id: 'bf', base: 't(-120,42,-25)',  ex: 't(-120,60,-25)',   start: 0.05, end: 0.70 },
    { id: 'f1', base: 't(-120,14,-25)',  ex: 't(-120,-50,-25)',  start: 0.12, end: 0.75 },
    { id: 'f2', base: 't(-120,-14,-25)', ex: 't(-120,-130,-25)', start: 0.22, end: 0.80 },
    { id: 'f3', base: 't(-120,-42,-25)', ex: 't(-120,-200,-25)', start: 0.32, end: 0.85 },
    { id: 'rf', base: 't(-120,-70,-25)', ex: 't(-120,-270,-25)', start: 0.42, end: 0.90 },
  ];

  const isSP = window.matchMedia('(max-width: 640px)').matches;
  const PARTS = isSP ? PARTS_SP : PARTS_D;

  function parseT(str) {
    const o = { x: 0, y: 0, z: 0, rx: 0, ry: 0 };
    if (!str) return o;
    const t = str.match(/t\(([-\d.]+),([-\d.]+),([-\d.]+)\)/);
    if (t) { o.x = +t[1]; o.y = +t[2]; o.z = +t[3]; }
    const ry = str.match(/ry\(([-\d.]+)\)/); if (ry) o.ry = +ry[1];
    const rx = str.match(/rx\(([-\d.]+)\)/); if (rx) o.rx = +rx[1];
    return o;
  }
  function buildT(o) {
    return `translate3d(${o.x}px,${o.y}px,${o.z}px) rotateX(${o.rx}deg) rotateY(${o.ry}deg)`;
  }
  function easeOut(t) { return 1 - Math.pow(1 - t, 3); }
  function clamp(v, a = 0, b = 1) { return Math.max(a, Math.min(b, v)); }

  function cameraTransform(p) {
    if (isSP) {
      return `translateZ(${-40 - p * 60}px) rotateX(${8 + p * 4}deg) rotateY(${-16 - p * 4}deg)`;
    }
    return `translateZ(${-80 - p * 120}px) rotateX(${10 + p * 4}deg) rotateY(${-22 - p * 4}deg)`;
  }

  const root  = document.getElementById('hcr-root');
  const scene = document.getElementById('hcr-scene');
  const steps = document.querySelectorAll('#hcr-progress .hcr-step');
  if (!root || !scene) return;

  const partData = PARTS.map(p => ({
    ...p,
    baseO: parseT(p.base),
    exO:   parseT(p.ex),
    el:    document.getElementById('hcr-' + p.id),
  })).filter(p => p.el);

  // Apply initial (assembled) transforms
  partData.forEach(p => { p.el.style.transform = buildT(p.baseO); });

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  let lastRectTop = 99999;
  let lastStep    = -1;
  let rafPending  = false;

  function applyScroll() {
    rafPending = false;
    const rect    = root.getBoundingClientRect();
    const rectTop = rect.top;
    if (Math.abs(rectTop - lastRectTop) < 0.5) return;
    lastRectTop = rectTop;

    const total = root.offsetHeight - window.innerHeight;
    if (total <= 0) { lastRectTop = 99999; return; }

    const scrolled = clamp(-rectTop / total);
    scene.style.transform = cameraTransform(scrolled);

    partData.forEach(p => {
      const lp    = clamp((scrolled - p.start) / Math.max(0.001, p.end - p.start));
      const eased = easeOut(lp);
      const o = {
        x:  p.baseO.x  + (p.exO.x  - p.baseO.x)  * eased,
        y:  p.baseO.y  + (p.exO.y  - p.baseO.y)  * eased,
        z:  p.baseO.z  + (p.exO.z  - p.baseO.z)  * eased,
        rx: p.baseO.rx + (p.exO.rx - p.baseO.rx) * eased,
        ry: p.baseO.ry + (p.exO.ry - p.baseO.ry) * eased,
      };
      p.el.style.transform = buildT(o);
    });

    let stage = 0;
    if (scrolled > 0.05) stage = 1;
    if (scrolled > 0.25) stage = 2;
    if (scrolled > 0.45) stage = 3;
    if (scrolled > 0.65) stage = 4;
    if (scrolled > 0.85) stage = 5;
    if (stage !== lastStep) {
      lastStep = stage;
      steps.forEach((el, i) => el.classList.toggle('hcr-step-on', i === stage));
    }
  }

  function scheduleUpdate() {
    if (rafPending) return;
    rafPending = true;
    requestAnimationFrame(applyScroll);
  }

  window.addEventListener('scroll',    scheduleUpdate, { passive: true });
  window.addEventListener('touchmove', scheduleUpdate, { passive: true });

  let polling = false;
  function pollLoop() {
    scheduleUpdate();
    if (polling) requestAnimationFrame(pollLoop);
  }

  const observer = new IntersectionObserver((entries) => {
    const visible = entries.some(e => e.isIntersecting);
    if (visible && !polling) { polling = true; requestAnimationFrame(pollLoop); }
    else if (!visible) { polling = false; }
  }, { threshold: 0 });
  observer.observe(root);

  polling = true;
  requestAnimationFrame(pollLoop);
})();
</script>
