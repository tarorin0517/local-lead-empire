---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FaqItem[];
  background?: 'soft' | 'plain';
}

const { faqs, background = 'soft' } = Astro.props;
const sectionClass =
  background === 'soft'
    ? 'bg-bg-soft px-4 py-12 sm:py-16'
    : 'px-4 py-12 sm:py-16';
---

{faqs.length > 0 && (
  <section class={sectionClass}>
    <div class="mx-auto max-w-3xl">
      <h2 class="text-center text-2xl font-bold text-primary-900 sm:text-3xl">
        よくあるご質問
      </h2>

      <dl class="mt-8 space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-lg border border-primary-100 bg-white p-5 shadow-sm">
            <summary class="flex cursor-pointer items-start justify-between gap-3 text-left">
              <span class="flex-1">
                <span class="mr-2 font-bold text-accent-500">Q.</span>
                <span class="font-bold text-ink">{faq.question}</span>
              </span>
              <span
                aria-hidden="true"
                class="mt-0.5 shrink-0 text-primary-700 transition-transform group-open:rotate-45"
              >
                ＋
              </span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">
              <span class="mr-2 font-bold text-primary-700">A.</span>
              {faq.answer}
            </p>
          </details>
        ))}
      </dl>
    </div>
  </section>
)}
