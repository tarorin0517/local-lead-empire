---
import type { SiteMeta } from '../lib/sites';

interface Props {
  site: SiteMeta;
}

const { site } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-5xl px-4 py-10 text-sm text-slate-700">
    <div class="grid gap-8 sm:grid-cols-2">
      <section>
        <h2 class="text-base font-bold text-slate-900">運営者情報</h2>
        <dl class="mt-3 space-y-1">
          <div class="flex gap-2">
            <dt class="w-20 shrink-0 text-slate-500">運営者</dt>
            <dd>{site.owner.name}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="w-20 shrink-0 text-slate-500">所在地</dt>
            <dd>{site.owner.address}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="w-20 shrink-0 text-slate-500">電話番号</dt>
            <dd>{site.phone}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="w-20 shrink-0 text-slate-500">メール</dt>
            <dd class="break-all">{site.owner.email}</dd>
          </div>
        </dl>
      </section>

      <section>
        <h2 class="text-base font-bold text-slate-900">関連ページ</h2>
        <ul class="mt-3 space-y-2">
          <li>
            <a class="text-brand-700 hover:underline" href={site.legal.tokushohoUrl}>
              特定商取引法に基づく表記
            </a>
          </li>
          <li>
            <a class="text-brand-700 hover:underline" href={site.legal.privacyUrl}>
              プライバシーポリシー
            </a>
          </li>
          <li>
            <a class="text-brand-700 hover:underline" href={site.baseUrlPath}>
              トップページ
            </a>
          </li>
        </ul>
        <p class="mt-4 text-xs leading-relaxed text-slate-500">
          本サイトは {site.siteName} が運営する自社サービス紹介サイトです。
          ステマ規制（景品表示法）に基づき、運営者を明示しています。
          複数業者を比較ランキング化する構造ではありません。
        </p>
      </section>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      © {year} {site.siteName}
    </p>
  </div>
</footer>
