---
import type { SiteMeta } from '../lib/sites';

interface Props {
  site: SiteMeta;
  lastUpdated?: Date;
}

const { site, lastUpdated } = Astro.props;
const year = new Date().getFullYear();
const lastUpdatedLabel = lastUpdated
  ? lastUpdated.toLocaleDateString('ja-JP', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---

<footer class="mt-0 border-t border-slate-200 bg-bg-soft">
  <div class="mx-auto max-w-5xl px-4 py-10 text-sm text-ink-muted">
    <div class="grid gap-8 sm:grid-cols-2">
      <section>
        <h2 class="text-base font-bold text-ink">運営者情報</h2>
        <dl class="mt-3 space-y-1">
          <div class="flex gap-2">
            <dt class="w-20 shrink-0 text-ink-muted">運営者</dt>
            <dd class="text-ink">{site.owner.name}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="w-20 shrink-0 text-ink-muted">所在地</dt>
            <dd class="text-ink">{site.owner.address}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="w-20 shrink-0 text-ink-muted">電話番号</dt>
            <dd class="text-ink">{site.phone}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="w-20 shrink-0 text-ink-muted">メール</dt>
            <dd class="break-all text-ink">{site.owner.email}</dd>
          </div>
        </dl>
      </section>

      <section>
        <h2 class="text-base font-bold text-ink">関連ページ</h2>
        <ul class="mt-3 space-y-2">
          <li>
            <a class="text-primary-700 hover:underline" href={site.legal.tokushohoUrl}>
              特定商取引法に基づく表記
            </a>
          </li>
          <li>
            <a class="text-primary-700 hover:underline" href={site.legal.privacyUrl}>
              プライバシーポリシー
            </a>
          </li>
          <li>
            <a class="text-primary-700 hover:underline" href={site.baseUrlPath}>
              トップページ
            </a>
          </li>
        </ul>
        <p class="mt-4 text-xs leading-relaxed text-ink-muted">
          本サイトは {site.siteName} が運営する自社サービス紹介サイトです。
          ステマ規制（景品表示法）に基づき、運営者を明示しています。
          複数業者を比較ランキング化する構造ではありません。
        </p>
      </section>
    </div>

    <div class="mt-8 flex flex-col gap-1 text-xs text-ink-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.siteName}</p>
      {lastUpdatedLabel && <p>最終更新日: {lastUpdatedLabel}</p>}
    </div>
  </div>
</footer>
