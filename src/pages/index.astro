---
import '../styles/global.css';
import { getAllSites } from '../lib/sites';

const sites = getAllSites();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>local-lead-empire — index</title>
  </head>
  <body class="min-h-screen bg-slate-50 px-4 py-10 text-slate-800">
    <main class="mx-auto max-w-2xl">
      <h1 class="text-2xl font-bold">local-lead-empire</h1>
      <p class="mt-2 text-sm text-slate-600">
        本ルートは内部用インデックスです（noindex）。各サイトは
        サブディレクトリ配下にあります。
      </p>
      <ul class="mt-6 space-y-2 text-sm">
        {sites.map((site) => (
          <li>
            <a class="text-blue-700 hover:underline" href={site.baseUrlPath}>
              {site.baseUrlPath}
            </a>
            {' — '}
            {site.siteName}（{site.city} × {site.niche}）
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
