---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  type SiteMeta,
  buildUrlPath,
  resolveEntry,
} from '../../lib/sites';

interface RouteProps {
  entry: CollectionEntry<'sites'>;
  site: SiteMeta;
  relativePath: string;
}

export async function getStaticPaths() {
  const entries = await getCollection(
    'sites',
    (entry) => !entry.data.draft,
  );

  const paths: {
    params: { site: string; slug: string | undefined };
    props: RouteProps;
  }[] = [];

  for (const entry of entries) {
    const resolved = resolveEntry(entry.id);
    if (!resolved) continue;
    const { site, relativePath } = resolved;

    // [site] パラメータ = basePath の最初のセグメント
    // [...slug] パラメータ = basePath の残り + コンテンツの相対パス
    const slugParts: string[] = site.basePathSegments.slice(1);
    if (relativePath) slugParts.push(...relativePath.split('/'));

    paths.push({
      params: {
        site: site.firstSegment,
        slug: slugParts.join('/') || undefined,
      },
      props: { entry, site, relativePath },
    });
  }

  return paths;
}

const { entry, site, relativePath } = Astro.props as RouteProps;
const { Content } = await render(entry);

const data = entry.data;
const urlPath = buildUrlPath(site, relativePath);
const isTop = !relativePath;
const kind = data.pageType ?? (isTop ? 'top' : 'article');

const breadcrumbs: { name: string; urlPath: string }[] = [
  { name: site.siteShortName ?? site.siteName, urlPath: site.baseUrlPath },
];
if (!isTop) {
  breadcrumbs.push({ name: data.title, urlPath });
}

const publishedTime = data.pubDate.toISOString();
const modifiedTime = data.updatedDate?.toISOString();
---

<SiteLayout
  site={site}
  title={data.title}
  description={data.description}
  urlPath={urlPath}
  kind={kind}
  author={data.author}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  faqs={data.faqs}
  breadcrumbs={breadcrumbs}
>
  {isTop && (
    <section class="rounded-2xl bg-gradient-to-br from-brand-600 to-brand-800 px-6 py-10 text-white shadow-md sm:px-10 sm:py-14">
      <p class="text-sm font-semibold tracking-wide text-brand-100">
        {site.city}・{site.niche}
      </p>
      <h1 class="mt-2 text-2xl font-bold leading-tight sm:text-4xl">
        {data.title}
      </h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-brand-50 sm:text-base">
        {site.tagline}
      </p>
      <ul class="mt-6 grid gap-3 text-sm sm:grid-cols-3">
        <li class="rounded-md bg-white/10 px-4 py-3">
          <span class="block text-xs text-brand-100">対応エリア</span>
          <span class="mt-1 block font-bold">
            {(site.areaServed ?? [site.city]).slice(0, 3).join('・')}ほか
          </span>
        </li>
        <li class="rounded-md bg-white/10 px-4 py-3">
          <span class="block text-xs text-brand-100">対応スピード</span>
          <span class="mt-1 block font-bold">{site.responseLabel ?? '即日対応可'}</span>
        </li>
        <li class="rounded-md bg-white/10 px-4 py-3">
          <span class="block text-xs text-brand-100">料金目安</span>
          <span class="mt-1 block font-bold">{site.priceRangeLabel ?? '要見積'}</span>
        </li>
      </ul>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="#contact"
          class="inline-flex items-center justify-center rounded-md bg-accent-500 px-5 py-3 text-sm font-bold text-white shadow hover:bg-accent-600"
        >
          無料で相談する
        </a>
        <a
          href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}
          class="inline-flex items-center justify-center rounded-md bg-white px-5 py-3 text-sm font-bold text-brand-700 shadow hover:bg-brand-50"
        >
          電話で相談 {site.phone}
        </a>
      </div>
    </section>
  )}

  {!isTop && (
    <nav aria-label="パンくずリスト" class="text-xs text-slate-500">
      <ol class="flex flex-wrap items-center gap-1">
        {breadcrumbs.map((b, i) => (
          <li class="flex items-center gap-1">
            {i > 0 && <span aria-hidden="true">/</span>}
            {i === breadcrumbs.length - 1 ? (
              <span class="text-slate-700">{b.name}</span>
            ) : (
              <a class="text-brand-700 hover:underline" href={b.urlPath}>{b.name}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )}

  {!isTop && (
    <h1 class="mt-3 text-2xl font-bold text-brand-900 sm:text-3xl">
      {data.title}
    </h1>
  )}

  <article class="prose-custom mt-8 max-w-none">
    <Content />
  </article>

  {data.faqs && data.faqs.length > 0 && (
    <section class="mt-12 rounded-lg border border-slate-200 bg-slate-50 p-6">
      <h2 class="text-xl font-bold text-brand-900">よくあるご質問</h2>
      <dl class="mt-4 space-y-5">
        {data.faqs.map((faq) => (
          <div>
            <dt class="font-bold text-slate-900">Q. {faq.question}</dt>
            <dd class="mt-1 text-sm leading-relaxed text-slate-700">A. {faq.answer}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}
</SiteLayout>

<style is:global>
  .prose-custom p {
    margin-block: 1.1em;
    line-height: 1.85;
  }
  .prose-custom h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1e3a8a;
    margin-top: 2.2rem;
    margin-bottom: 0.8rem;
    border-bottom: 2px solid #dbeafe;
    padding-bottom: 0.4rem;
  }
  .prose-custom h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #1d4ed8;
    margin-top: 1.6rem;
    margin-bottom: 0.5rem;
  }
  .prose-custom strong {
    color: #1d4ed8;
  }
  .prose-custom a {
    color: #1d4ed8;
    text-decoration: underline;
  }
  .prose-custom ul {
    list-style: disc;
    padding-left: 1.4rem;
    margin-block: 1em;
  }
  .prose-custom ol {
    list-style: decimal;
    padding-left: 1.6rem;
    margin-block: 1em;
  }
</style>
