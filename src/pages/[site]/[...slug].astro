---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Hero from '../../components/Hero.astro';
import HeroAircon from '../../components/HeroAircon.astro';
import HeroCivilRealestate from '../../components/HeroCivilRealestate.astro';
import CivilServantLP from '../../components/CivilServantLP.astro';
import Worries from '../../components/Worries.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Reasons from '../../components/Reasons.astro';
import PriceTable from '../../components/PriceTable.astro';
import Options from '../../components/Options.astro';
import Flow from '../../components/Flow.astro';
import AreaList from '../../components/AreaList.astro';
import Voice from '../../components/Voice.astro';
import FAQ from '../../components/FAQ.astro';
import Company from '../../components/Company.astro';
import ContactForm from '../../components/ContactForm.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import ColumnList from '../../components/ColumnList.astro';
import {
  type SiteMeta,
  buildUrlPath,
  resolveEntry,
} from '../../lib/sites';

interface RouteProps {
  entry: CollectionEntry<'sites'>;
  site: SiteMeta;
  relativePath: string;
}

export async function getStaticPaths() {
  const entries = await getCollection(
    'sites',
    (entry) => !entry.data.draft,
  );

  const paths: {
    params: { site: string; slug: string | undefined };
    props: RouteProps;
  }[] = [];

  for (const entry of entries) {
    const resolved = resolveEntry(entry.id);
    if (!resolved) continue;
    const { site, relativePath } = resolved;

    const slugParts: string[] = site.basePathSegments.slice(1);
    if (relativePath) slugParts.push(...relativePath.split('/'));

    paths.push({
      params: {
        site: site.firstSegment,
        slug: slugParts.join('/') || undefined,
      },
      props: { entry, site, relativePath },
    });
  }

  return paths;
}

const { entry, site, relativePath } = Astro.props as RouteProps;
const { Content } = await render(entry);

const data = entry.data;
const urlPath = buildUrlPath(site, relativePath);
const isTop = !relativePath;
const kind = data.pageType ?? (isTop ? 'top' : 'article');

const breadcrumbs: { name: string; urlPath: string }[] = [
  { name: site.siteShortName ?? site.siteName, urlPath: site.baseUrlPath },
];
if (!isTop) {
  breadcrumbs.push({ name: data.title, urlPath });
}

const publishedTime = data.pubDate.toISOString();
const modifiedTime = data.updatedDate?.toISOString();
const lastUpdated = data.updatedDate ?? data.pubDate;
---

<SiteLayout
  site={site}
  title={data.title}
  description={data.description}
  urlPath={urlPath}
  kind={kind}
  author={data.author}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  faqs={data.faqs}
  breadcrumbs={breadcrumbs}
  hideAutoContactForm={isTop}
  fullBleed={isTop}
  lastUpdated={lastUpdated}
>
  {isTop ? (
    site.niche === '公務員不動産投資' ? (
      <CivilServantLP site={site} faqs={data.faqs} />
    ) : (
    <>
      {/* Section 1: Hero (ニッチ別に専用アニメーションを使い分け) */}
      {site.niche === 'エアコン分解洗浄'
        ? <HeroAircon site={site} />
        : <Hero site={site} />
      }

      {/* Section 1.5: QuickAnswer（AEO事実ボックス） */}
      <QuickAnswer site={site} />

      {/* Section 2: Worries */}
      <Worries site={site} />

      {/* Section 3: Before/After */}
      <BeforeAfter site={site} />

      {/* Section 4: Reasons */}
      <Reasons site={site} />

      {/* Section 5: PriceTable */}
      <PriceTable site={site} />

      {/* Section 6: Options */}
      <Options site={site} />

      {/* Section 7: Flow */}
      <Flow site={site} />

      {/* Section 8: AreaList */}
      <AreaList site={site} />

      {/* Section 9: Voice */}
      <Voice site={site} />

      {/* Section 10: FAQ */}
      {data.faqs && data.faqs.length > 0 && <FAQ faqs={data.faqs} />}

      {/* Section 11: ColumnList（内部リンク） */}
      <ColumnList site={site} />

      {/* Section 12: Company */}
      <Company site={site} />

      {/* Section 13: ContactForm（SiteLayout の自動描画は抑止済） */}
      <ContactForm site={site} />

      {/* トップページの本文 Markdown は冒頭リード文として目立たない位置に */}
      <section class="bg-white px-4 py-12">
        <div class="prose-custom mx-auto max-w-3xl text-sm leading-relaxed text-ink-muted">
          <Content />
        </div>
      </section>
    </>
    )
  ) : (
    <>
      <nav aria-label="パンくずリスト" class="text-xs text-ink-muted">
        <ol class="flex flex-wrap items-center gap-1">
          {breadcrumbs.map((b, i) => (
            <li class="flex items-center gap-1">
              {i > 0 && <span aria-hidden="true">/</span>}
              {i === breadcrumbs.length - 1 ? (
                <span class="text-ink">{b.name}</span>
              ) : (
                <a class="text-primary-700 hover:underline" href={b.urlPath}>{b.name}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>

      <h1 class="mt-3 text-2xl font-bold text-primary-900 sm:text-3xl">
        {data.title}
      </h1>

      <article class="prose-custom mt-8 max-w-none">
        <Content />
      </article>

      {data.faqs && data.faqs.length > 0 && (
        <FAQ faqs={data.faqs} background="plain" />
      )}

      {/* 内部リンクCTA：記事下部からトップページへの誘導 */}
      <div class="mt-10 rounded-xl border border-primary-200 bg-primary-50 p-6">
        <p class="text-sm font-medium text-primary-900">
          {site.city}の{site.niche}は<strong>まちのプロ</strong>にご相談ください
        </p>
        <p class="mt-1 text-xs text-ink-muted">
          無料見積もり・即日対応可・損害保険加入済
        </p>
        <div class="mt-3 flex flex-wrap gap-3">
          <a
            href={site.baseUrlPath}
            class="inline-flex items-center gap-1 rounded-md bg-primary-700 px-4 py-2 text-sm font-bold text-white hover:bg-primary-900"
          >
            サービス詳細・料金を見る →
          </a>
          <a
            href={`tel:${site.phone}`}
            class="inline-flex items-center gap-1 rounded-md border border-primary-700 px-4 py-2 text-sm font-bold text-primary-700 hover:bg-primary-100"
            onclick={`if(typeof gtag!=='undefined'){gtag('event','generate_lead',{method:'phone',event_label:'article_bottom'});gtag('event','phone_click',{event_category:'cta',event_label:'article_bottom'})}`}
          >
            📞 {site.phone}
          </a>
        </div>
      </div>
    </>
  )}
</SiteLayout>

<style is:global>
  .prose-custom p {
    margin-block: 1.1em;
    line-height: 1.85;
  }
  .prose-custom h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-primary-900);
    margin-top: 2.2rem;
    margin-bottom: 0.8rem;
    border-bottom: 2px solid var(--color-primary-100);
    padding-bottom: 0.4rem;
  }
  .prose-custom h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary-700);
    margin-top: 1.6rem;
    margin-bottom: 0.5rem;
  }
  .prose-custom strong {
    color: var(--color-primary-700);
  }
  .prose-custom a {
    color: var(--color-primary-700);
    text-decoration: underline;
  }
  .prose-custom ul {
    list-style: disc;
    padding-left: 1.4rem;
    margin-block: 1em;
  }
  .prose-custom ol {
    list-style: decimal;
    padding-left: 1.6rem;
    margin-block: 1em;
  }
</style>
