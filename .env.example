# 本番ドメイン（後で差し替え可能）
SITE_URL=https://machi-no-pro.com

# 運営者情報を _meta.json ではなく環境変数で渡したい場合に設定
# （PII を Git にコミットしたくないとき推奨）
SITE_OWNER_NAME=
SITE_OWNER_ADDRESS=
SITE_OWNER_EMAIL=

# お問い合わせフォーム送信先（Formspree）
# 取得方法: https://formspree.io でフォーム作成 → エンドポイント URL をコピー
# 例: https://formspree.io/f/xyzabc12
PUBLIC_FORM_ENDPOINT=

# Google広告コンバージョンタグ ID
# 取得方法: Google広告 → 目標 → コンバージョン → 新しいコンバージョンアクション
#   → ウェブサイト → 「Googleタグを設置する」ステップに表示される AW-XXXXXXXXXX
# Cloudflare Pages の環境変数に設定すること（ローカルの .env にも入れておくと開発確認できる）
PUBLIC_GOOGLE_ADS_TAG=
