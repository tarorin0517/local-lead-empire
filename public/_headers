# Cloudflare Pages カスタムヘッダー（Core Web Vitals + セキュリティ改善）
# https://developers.cloudflare.com/pages/configuration/headers/
#
# 注意: _headers の path ルールはホスト名で分岐できない。
# *.pages.dev プレビューを noindex にする処理は functions/_middleware.ts に集約する。

# 静的アセット（ハッシュ付き）は長期キャッシュ
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# フォント：長期キャッシュ
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# OG画像：中期キャッシュ
/og/*
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

# サイトマップ・ロボッツはキャッシュ短め
/sitemap*.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

# HTMLページ：ストール時再検証 + セキュリティヘッダー
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  # HSTS: 1年間 HTTPS を強制（includeSubDomains は慎重に）
  Strict-Transport-Security: max-age=31536000
  # カメラ・マイク・位置情報など不要な API を無効化（ユーザー信頼性向上）
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # 外部スクリプトはGA4/GTMのみ。style-src unsafe-inline はTailwind inline style対応
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com; frame-src https://docs.google.com; object-src 'none'; base-uri 'self'
