# Cloudflare Pages: グローバル HTTP ヘッダ設定
# https://developers.cloudflare.com/pages/configuration/headers/
#
# 注意: _headers の path ルールはホスト名で分岐できない。
# *.pages.dev プレビューを noindex にする処理は functions/_middleware.ts に集約する。

# 静的アセット（ハッシュ付き）は長期キャッシュ
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# 画像系: 1日キャッシュ（差し替え運用しやすく）
/og/*
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

# HTML はデフォルトのまま（Cloudflare 側で制御）
# サイトマップ・ロボッツはキャッシュ短め
/sitemap*.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
